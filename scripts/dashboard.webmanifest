{
  "name": "Dashboard - Sistema EvaluaPro",
  "short_name": "Dashboard EP",
  "description": "Control local del stack, tareas, logs y salud de servicios.",
  "lang": "es",
  "dir": "ltr",
  "id": "/pwa/evaluapro/dashboard-local",
  "start_url": "/#tab=main&source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#02030a",
  "theme_color": "#02030a",
  "prefer_related_applications": false,
  "categories": ["utilities", "productivity", "education"],
  "icons": [
    {
      "src": "/assets/dashboard-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/dashboard-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/dashboard-icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/assets/dashboard-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/assets/dashboard-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Principal",
      "short_name": "Principal",
      "url": "/#tab=main",
      "icons": [{ "src": "/assets/dashboard-icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Estado y logs",
      "short_name": "Logs",
      "url": "/#tab=status",
      "icons": [{ "src": "/assets/dashboard-icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Base de datos",
      "short_name": "DB",
      "url": "/#tab=db",
      "icons": [{ "src": "/assets/dashboard-icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "x_evaluapro": {
    "surface": "dashboard-local",
    "version": "1.0.0b",
    "schemaVersion": "2026-03-21.1",
    "launcherPreferred": true,
    "offlineCapable": false
  }
}
