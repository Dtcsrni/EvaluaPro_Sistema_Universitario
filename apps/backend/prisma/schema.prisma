  id                       String    @id @default(uuid())
  licenciaId               String    @unique
  tenantId                 String
  planId                   String
  tipo                     String
  canalRelease             String
  firmaToken               String
  limiteDispositivos       Int       @default(1)
  expiraEn                 DateTime?
  activo                   Boolean   @default(true)
  tokenLicencia            String    @unique
  tokenLicenciaHash        String    @unique
  codigoActivacion         String    @unique
  graciaOfflineDias        Int       @default(7)
  estado                   String    @default("generada")
  activadaEn               DateTime?
  ultimoHeartbeatEn        DateTime?
  ultimoCanalRelease       String    @default("stable")
  dispositivoVinculadoHash String?
  nonceUltimo              String?
  contadorHeartbeat        Int       @default(0)
  intentosFallidos         Int       @default(0)
  puntajeAnomalia          Int       @default(0)
  revocadaRazon            String?
  metaDispositivo          String?   // JSON string
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@map("licencias")
}

