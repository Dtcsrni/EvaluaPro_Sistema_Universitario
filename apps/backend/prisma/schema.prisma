// ─── MODELOS COMERCIAL CORE Y TENANCY ─────────────────────────────────────────

model Tenant {
  id                String          @id @default(uuid())
  tenantId          String          @unique
  nombre            String
  tipoTenant        String
  modalidad         String
  estado            String
  pais              String
  moneda            String
  ownerDocenteId    String
  contacto          String?         // JSON string
  configAislamiento String          // JSON string
  tags              String          @default("[]") // JSON array
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@map("tenants")
}

model Suscripcion {
  id                   String          @id @default(uuid())
  tenantId             String
  planId               String
  ciclo                String
  estado               String
  pasarela             String
  precioAplicado       Float
  tokenPreaprobacion   String?
  siguienteVencimiento DateTime?
  trial                String?         // JSON string
  fechaRenovacion      DateTime?
  descuentoAplicado    Float           @default(0)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@map("suscripciones")
}

model Cobranza {
  id                String          @id @default(uuid())
  tenantId          String
  suscripcionId     String
  monto             Float
  moneda            String
  pasarela          String
  estado            String
  fechaPago         DateTime?
  metodoPago        String?
  notificadoWebhook Boolean         @default(false)
  referenciaExterna String?
  webhookEventId    String?         @unique
  metadata          String?         // JSON string
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@map("cobranzas")
}

