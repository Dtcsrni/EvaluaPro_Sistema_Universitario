{
  "name": "backend",
  "description": "API docente (Express + TypeScript + SQLite nativo/Prisma) para gestión de evaluaciones, autenticación y flujo de examen OMR.",
  "version": "1.1.3",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Dtcsrni/EvaluaPro_Sistema_Universitario"
  },
  "keywords": [
    "api",
    "express",
    "typescript",
    "sqlite",
    "prisma",
    "omr",
    "evaluacion",
    "docente"
  ],
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc --project tsconfig.json",
    "typecheck": "prisma generate && tsc --noEmit --project tsconfig.json --pretty false",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:coverage": "node ../../scripts/testing/run-backend-coverage-batches.mjs",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\" --max-warnings=0",
    "dev:omr:geo-tight": "tsx scripts/omr-run-dev-profile.ts geo_tight_search",
    "dev:omr:actual": "tsx scripts/omr-run-dev-profile.ts actual",
    "auth:reset-password": "tsx scripts/auth-reset-password.ts",
    "omr:eval:profile": "tsx scripts/omr-eval-profile.ts",
    "omr:sweep:geometria": "tsx scripts/omr-sweep-geometria.ts",
    "omr:sweep:umbrales": "tsx scripts/omr-sweep-umbrales.ts",
    "omr:diagnose:rechazo": "tsx scripts/omr-diagnose-rechazo.ts",
    "omr:cv:smoke": "tsx scripts/omr-cv-smoke.ts",
    "omr:generate:synthetic": "tsx scripts/omr-tv4-generate-synthetic.ts --dataset ../../omr_samples_tv4",
    "omr:eval:synthetic": "tsx scripts/omr-tv4-eval-synthetic.ts --dataset ../../omr_samples_tv4 --report ../../reports/qa/latest/omr/canonical-synthetic-eval.json",
    "omr:build:pilot-real": "tsx scripts/omr-tv4-build-pilot-real.ts --dataset ../../omr_samples_tv4_pilot_real",
    "omr:validate:pilot-real": "tsx scripts/omr-tv4-validate-pilot-real.ts --dataset ../../omr_samples_tv4_pilot_real --report ../../reports/qa/latest/omr/canonical-pilot-real-validation.json --failure-report ../../reports/qa/latest/omr/canonical-pilot-real-failures.json",
    "omr:diagnose:pilot-real": "tsx scripts/omr-tv4-diagnose-pilot-real.ts --dataset ../../omr_samples_tv4_pilot_real --out-dir ../../reports/qa/latest/omr/canonical-pilot-real-diagnose",
    "recovery:bundles:list": "tsx scripts/recovery-list-bundles.ts",
    "recovery:verify": "tsx scripts/recovery-verify.ts",
    "recovery:manifest:reconstruct": "tsx scripts/recovery-reconstruct-manifest.ts",
    "recovery:bundle:reconstruct": "tsx scripts/recovery-reconstruct-bundle.ts"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "decimal.js": "^10.6.0",
    "docx": "^9.6.0",
    "dotenv": "^17.3.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "google-auth-library": "^10.6.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "jsqr": "^1.4.0",
    "multer": "^2.2.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.58.2",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.4",
    "@eslint/js": "^9.39.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/qrcode": "^1.5.6",
    "prisma": "^6.19.3"
  }
}
