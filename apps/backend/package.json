{
  "name": "backend",
  "description": "API docente (Express + TypeScript + MongoDB) para gestión de evaluaciones, autenticación y flujo de examen.",
  "version": "1.0.0-beta.1",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Dtcsrni/EvaluaPro_Sistema_Universitario"
  },
  "keywords": [
    "api",
    "express",
    "typescript",
    "mongodb",
    "mongoose",
    "evaluacion",
    "docente"
  ],
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit --project tsconfig.json --pretty false",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\" --max-warnings=0",
    "dev:omr:geo-tight": "tsx scripts/omr-run-dev-profile.ts geo_tight_search",
    "dev:omr:actual": "tsx scripts/omr-run-dev-profile.ts actual",
    "auth:reset-password": "tsx scripts/auth-reset-password.ts",
    "omr:eval:profile": "tsx scripts/omr-eval-profile.ts",
    "omr:sweep:geometria": "tsx scripts/omr-sweep-geometria.ts",
    "omr:sweep:umbrales": "tsx scripts/omr-sweep-umbrales.ts",
    "omr:diagnose:rechazo": "tsx scripts/omr-diagnose-rechazo.ts",
    "omr:cv:smoke": "tsx scripts/omr-cv-smoke.ts",
    "omr:tv3:connect:por-folio-flow": "tsx scripts/omr-tv3-connect-por-folio-flow.ts",
    "omr:tv3:generate:synthetic": "tsx scripts/omr-tv3-generate-synthetic.ts --dataset ../../omr_samples_tv3",
    "omr:tv3:build:por-folio-dataset": "tsx scripts/omr-tv3-build-por-folio-dataset.ts --dataset omr_samples_tv3_real_por_folio",
    "omr:tv3:generate:real": "tsx scripts/omr-tv3-generate-from-finals.ts --dataset ../../omr_samples_tv3_real --report ../../reports/qa/latest/omr/real_dataset_generation_report.json --variants 24 --dataset-type tv3_real_from_finals_templates --invalid-detection-min 0.8",
    "omr:tv3:generate:real:manual-min": "tsx scripts/omr-tv3-generate-from-finals.ts --dataset ../../omr_samples_tv3_real_manual_min --report ../../reports/qa/latest/omr/real_manual_dataset_generation_report.json --variants 6 --dataset-type tv3_real_manual_min_from_finals_templates --invalid-detection-min 0.75",
    "omr:tv3:eval:synthetic": "tsx scripts/omr-tv3-eval-synthetic.ts --dataset ../../omr_samples_tv3 --report ../../reports/qa/latest/omr/synthetic-eval.json",
    "omr:tv3:diagnose:por-folio": "tsx scripts/omr-tv3-diagnose-por-folio.ts --dataset ../../omr_samples_tv3_real_por_folio --out-dir ../../reports/qa/latest/omr/por-folio-diagnose",
    "omr:tv3:analyze:photo-content": "tsx scripts/omr-tv3-analyze-photo-exam-content.ts --organization \"../../omr_samples_tv3/images/Por Folio/_organizacion_por_alumno.json\" --canonical ../../reports/qa/latest/por_folio_analysis_from_zero.json --out ../../reports/qa/latest/por_folio_photo_content_validation.json",
    "omr:tv3:extract:photo-content:ocr-only": "tsx scripts/omr-tv3-extract-photo-content-ocr-only.ts --organization \"../../omr_samples_tv3/images/Por Folio/_organizacion_por_alumno.json\" --out ../../reports/qa/latest/por_folio_photo_content_ocr_only.json",
    "omr:tv3:build:human-review-pack": "npx tsx scripts/omr-tv3-build-human-review-pack.ts --manifest ../../omr_samples_tv3_real_por_folio/manifest.json --organization \"../../omr_samples_tv3/images/Por Folio/_organizacion_por_alumno.json\" --canonical ../../reports/qa/latest/por_folio_analysis_from_zero.json --ocr-only ../../reports/qa/latest/por_folio_photo_content_ocr_only.json --out-dir ../../reports/qa/latest/por_folio_human_review",
    "omr:tv3:validate:por-folio": "tsx scripts/omr-tv3-validate-por-folio.ts --dataset ../../omr_samples_tv3_real_por_folio --report ../../reports/qa/latest/omr/tv3-por-folio-validation.json --failure-report ../../reports/qa/latest/omr/tv3-por-folio-failures.json",
    "omr:tv3:validate:real": "tsx scripts/omr-tv3-validate-real.ts --dataset ../../omr_samples_tv3_real --report ../../reports/qa/latest/omr/tv3-real-validation.json --failure-report ../../reports/qa/latest/omr/tv3-real-failure-analysis.json",
    "omr:tv3:validate:real:manual-min": "tsx scripts/omr-tv3-validate-real.ts --dataset ../../omr_samples_tv3_real_manual_min --report ../../reports/qa/latest/omr/tv3-real-manual-validation.json --failure-report ../../reports/qa/latest/omr/tv3-real-manual-failure-analysis.json",
    "omr:tv3:baseline:snapshot": "tsx scripts/omr-tv3-baseline-snapshot.ts --dataset-synthetic ../../omr_samples_tv3 --dataset-real ../../omr_samples_tv3_real --report ../../reports/qa/latest/omr/baseline_snapshot.json",
    "omr:tv3:calibrate:real": "tsx scripts/omr-tv3-calibrate-real.ts --dataset ../../omr_samples_tv3_real --report ../../reports/qa/latest/omr/calibration_iterations.json --decision ../../reports/qa/latest/omr/calibration_decision.md",
    "omr:tv3:optimize:synthetic": "tsx scripts/omr-tv3-optimize-synthetic.ts --dataset ../../omr_samples_tv3 --report ../../reports/qa/latest/omr/synthetic-optimization.json",
    "omr:tv3:e2e:synthetic": "tsx scripts/omr-tv3-e2e.ts --dataset ../../omr_samples_tv3 --report ../../reports/qa/latest/omr-tv3-gate.json",
    "omr:tv3:eval:golden": "tsx scripts/omr-tv3-eval-golden.ts --dataset ../../omr_samples_tv3 --report ../../reports/qa/latest/omr-tv3-gate.json"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "decimal.js": "^10.6.0",
    "docx": "^9.6.0",
    "dotenv": "^17.3.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "google-auth-library": "^10.6.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "jsqr": "^1.4.0",
    "mongoose": "^9.2.3",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.58.2",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.4",
    "@eslint/js": "^9.39.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/qrcode": "^1.5.6"
  }
}
