exports[`UX visual regression > admin negocio mantiene layout principal 1`] = `
<DocumentFragment>
  <div
    class="panel glass-card anim-fade-in cuenta-panel admin-negocio-shell superficie-app superficie-app--negocio"
    data-admin-negocio="true"
  >
    <div
      class="admin-negocio-shell__header"
    >
      <div>
        <p
          class="eyebrow"
        >
          <svg
            aria-hidden="true"
            class="lucide lucide-graduation-cap icono"
            data-icono="docente"
            fill="none"
            focusable="false"
            height="20"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            width="20"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"
            />
            <path
              d="M22 10v6"
            />
            <path
              d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"
            />
          </svg>
           Panel estratégico
        </p>
        <h2>
          Panel de Negocio EvaluaPro
        </h2>
        <p
          class="admin-negocio-shell__lead"
        >
          Supervisa métricas comerciales, licencias y cobranza con una lectura más ejecutiva y controlada.
        </p>
        <p
          class="nota"
        >
          Usuario: 
          <b>
            Sin sesion
          </b>
           (-)
        </p>
      </div>
      <div
        class="badge"
      >
        Vista activa: Resumen
      </div>
    </div>
    <div
      class="subpanel"
    >
      <p
        class="mensaje warning"
        role="status"
      >
        <span
          class="mensaje__icono"
        >
          <svg
            aria-hidden="true"
            class="lucide lucide-triangle-alert lucide-alert-triangle icono"
            data-icono="alerta"
            fill="none"
            focusable="false"
            height="20"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            width="20"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"
            />
            <path
              d="M12 9v4"
            />
            <path
              d="M12 17h.01"
            />
          </svg>
        </span>
        <span
          class="mensaje__contenido"
        >
          Este panel requiere permisos comerciales. Ingresa con tu cuenta Google superadmin o asigna permisos comerciales a tu usuario.
        </span>
      </p>
    </div>
  </div>
</DocumentFragment>
`;

