                    stop-color="#2563eb"
                  />
                  <stop
                    offset="1"
                    stop-color="#00d2ff"
                  />
                </lineargradient>
              </defs>
            </svg>
          </div>
        </div>
        <ul
          aria-label="Beneficios"
          class="auth-feature-list auth-beneficios"
        >
          <li
            class="auth-feature-card"
          >
            <div
              class="auth-feature-card__icon"
            >
              <svg
                aria-hidden="true"
                class="icono"
                data-icono="banco"
                fill="none"
                height="18"
                viewBox="0 0 24 24"
                width="18"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M4 6a2 2 0 0 1 2-2h11a2 2 0 0 1 2 2v14H6a2 2 0 0 0-2 2V6Z"
                  stroke="currentColor"
                  stroke-linejoin="round"
                  stroke-width="2"
                />
                <path
                  d="M6 20h13"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-width="2"
                />
                <path
                  d="M8 8h8M8 12h6"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-width="2"
                />
              </svg>
            </div>
            <div
              class="auth-feature-card__body"
            >
              <strong>
                Gestión de Cursos y Banco
              </strong>
              <p>
                Organiza materias, listas de alumnos y preguntas por competencias.
              </p>
            </div>
          </li>
          <li
            class="auth-feature-card"
          >
            <div
              class="auth-feature-card__icon"
            >
              <svg
                aria-hidden="true"
                class="icono"
                data-icono="escaneo"
                fill="none"
                height="18"
                viewBox="0 0 24 24"
                width="18"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M7 3H5a2 2 0 0 0-2 2v2M17 3h2a2 2 0 0 1 2 2v2M7 21H5a2 2 0 0 1-2-2v-2M17 21h2a2 2 0 0 0 2-2v-2"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-width="2"
                />
                <path
                  d="M8 12h8"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-width="2"
                />
              </svg>
            </div>
            <div
              class="auth-feature-card__body"
            >
              <strong>
                Calificación OMR Instantánea
              </strong>
              <p>
                Genera exámenes impresos y procesa hojas de respuestas ópticas al instante.
              </p>
            </div>
          </li>
          <li
            class="auth-feature-card"
          >
            <div
              class="auth-feature-card__icon"
            >
              <svg
                aria-hidden="true"
                class="icono"
                data-icono="ok"
                fill="none"
                height="18"
                viewBox="0 0 24 24"
                width="18"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M9 12l2 2 4-5"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                />
              </svg>
            </div>
            <div
              class="auth-feature-card__body"
            >
              <strong>
                Privacidad y Datos Locales
              </strong>
              <p>
                Tus calificaciones se almacenan de forma segura en tu equipo sin dependencias externas.
              </p>
            </div>
          </li>
        </ul>
      </div>
      <div
        class="auth-form auth-form--registrar"
      >
        <div
          class="auth-form-head"
        >
          <div
            class="acciones auth-tabs"
          >
            <button
              class="boton secundario auth-tab"
              type="button"
            >
              Ingresar
            </button>
            <button
              class="boton auth-tab auth-tab--activo"
              type="button"
            >
              Registrar
            </button>
          </div>
          <h3
            class="mt-12"
          >
            Registro docente y activación de licencia
          </h3>
          <p
            class="nota"
          >
            Crea tu cuenta institucional y establece tu clave de licencia para activar la plataforma.
          </p>
        </div>
        <div
          aria-label="Ayuda de registro"
          class="panel auth-panel"
        >
          <p
            class="nota"
          >
            Para registrar tu cuenta completa 
            <b>
              nombres
            </b>
            , 
            <b>
              apellidos
            </b>
             y 
            <b>
              correo
            </b>
            . La contraseña requiere mínimo 8 caracteres.
          </p>
        </div>
        <p
          class="mensaje"
          role="status"
        >
          <span
            class="mensaje__icono"
          >
            <svg
              aria-hidden="true"
              class="icono"
              data-icono="info"
              fill="none"
              height="18"
              viewBox="0 0 24 24"
              width="18"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M12 17v-5"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-width="2"
              />
              <path
                d="M12 8h.01"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-width="3"
              />
              <path
                d="M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20Z"
                stroke="currentColor"
                stroke-width="2"
              />
            </svg>
          </span>
          <span
            class="mensaje__contenido"
          >
            Inicio de sesión con Google deshabilitado en este entorno. Para habilitarlo en desarrollo, define VITE_GOOGLE_CLIENT_ID en el .env del root y reinicia Vite.
          </span>
        </p>
        <label
          class="campo auth-campo"
        >
          Nombres
          <input
            autocomplete="given-name"
            placeholder="Ej. Juan Carlos"
            value=""
          />
        </label>
        <label
          class="campo auth-campo"
        >
          Apellidos
          <input
            autocomplete="family-name"
            placeholder="Ej. Perez Lopez"
            value=""
          />
        </label>
        <label
          class="campo auth-campo"
        >
          Correo
          <input
            autocomplete="email"
            type="email"
            value=""
          />
        </label>
        <label
          class="campo auth-campo"
        >
          Clave o Código de Licencia (opcional / institucional)
          <input
            autocomplete="off"
            placeholder="Ej. LIC-2026-DOC-XXXX-XXXX"
            spellcheck="false"
            value=""
          />
          <span
            class="ayuda"
          >
            Si cuentas con una clave institucional, ingrésala para activar tu licencia docente de inmediato.
          </span>
        </label>
        <label
          class="campo auth-campo"
        >
          Contraseña
          <input
            autocomplete="new-password"
            type="password"
            value=""
          />
        </label>
        <div
          class="acciones auth-submit"
        >
          <button
            class="boton boton--lg boton--con-icono"
            disabled=""
            type="button"
          >
            <span
              class="boton__icono"
            >
              <svg
                aria-hidden="true"
                class="icono"
                data-icono="nuevo"
                fill="none"
                height="18"
                viewBox="0 0 24 24"
                width="18"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M12 7v10"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-width="2"
                />
                <path
                  d="M7 12h10"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-width="2"
                />
                <path
                  d="M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20Z"
                  stroke="currentColor"
                  stroke-width="2"
                />
              </svg>
            </span>
            <span
              class="boton__texto"
            >
              Crear cuenta
            </span>
          </button>
        </div>
      </div>
    </div>
  </section>
</DocumentFragment>
`;
