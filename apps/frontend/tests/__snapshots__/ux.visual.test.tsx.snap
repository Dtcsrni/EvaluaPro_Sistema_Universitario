            src="/favicon-docente.svg"
          />
        </div>
        <div>
          <h1
            class="auth-portal__title"
          >
            Plataforma Docente
          </h1>
          <span
            class="auth-portal__subtitle"
          >
            EvaluaPro · Sistema Universitario
          </span>
        </div>
      </div>
      <div
        class="auth-portal__top-actions"
      >
        <button
          class="chip chip-version"
          title="Abrir información de versión"
          type="button"
        >
          v1.1.1
        </button>
        <button
          aria-label="Tema: Auto (Oscuro)"
          class="boton secundario boton--tema"
          title="Cambiar tema (Auto / Claro / Oscuro)"
          type="button"
        >
          <svg
            aria-hidden="true"
            class="icono"
            height="18"
            viewBox="0 0 24 24"
            width="18"
          >
            <path
              d="M12 4a8 8 0 1 0 0 16V4Z"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            />
            <path
              d="M12 4a8 8 0 0 1 0 16"
              fill="none"
              opacity="0.5"
              stroke="currentColor"
              stroke-width="2"
            />
          </svg>
          <span
            class="boton--temaTexto"
          >
            Tema: Auto (Oscuro)
          </span>
        </button>
      </div>
    </header>
    <div
      class="auth-stage-layout"
    >
      <div
        class="auth-showcase"
      >
        <div
          class="auth-showcase-badge"
        >
          <span
            class="auth-pulse-dot"
          />
           Suite Universitaria Local · v1.1.1
        </div>
        <h2
          class="auth-showcase-title"
        >
          Evaluación docente y 
          <span
            class="auth-gradient-text"
          >
            calificación OMR instantánea
          </span>
        </h2>
        <p
          class="auth-showcase-desc"
        >
          Diseña materias, genera exámenes impresos con código QR de vinculación y procesa hojas ópticas en segundos con total privacidad local.
        </p>
        <div
          aria-hidden="true"
          class="auth-omr-mockup-card"
        >
          <div
            class="auth-omr-sheet"
          >
            <div
              class="auth-omr-header-row"
            >
              <div
                class="auth-omr-meta"
              >
                <span
                  class="auth-omr-chip"
                >
                  EXAMEN PARCIAL · FOLIO: #EP-2026-A
                </span>
                <div
                  class="auth-omr-lines"
