    role="alert"
  >
    <span
      class="mensaje__icono"
    >
      <svg
        aria-hidden="true"
        class="lucide lucide-triangle-alert lucide-alert-triangle icono"
        data-icono="alerta"
        fill="none"
        focusable="false"
        height="20"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        viewBox="0 0 24 24"
        width="20"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"
        />
        <path
          d="M12 9v4"
        />
        <path
          d="M12 17h.01"
        />
      </svg>
    </span>
    <span
      class="mensaje__contenido"
    >
      No se pudo cargar el resumen de inasistencias. El indicador no está disponible.
    </span>
  </p>
  <button
    class="boton secundario boton--sm"
    type="button"
  >
    <span
      class="boton__texto"
    >
      Reintentar resumen
    </span>
  </button>
</div>
`;

