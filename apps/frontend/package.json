{
  "name": "frontend",
  "description": "UI React 18 (Vite + TailwindCSS + Bento Elevation) para portal docente/alumno: autenticación, gestión de evaluaciones, diseño de exámenes y flujos de calificación OMR.",
  "version": "1.2.10",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dtcsrni/EvaluaPro_Sistema_Universitario"
  },
  "keywords": [
    "react",
    "vite",
    "frontend",
    "docente",
    "alumno",
    "evaluacion"
  ],
  "scripts": {
    "dev": "vite --configLoader runner",
    "dev:alumno": "node --input-type=module -e \"import {spawnSync} from 'node:child_process';const env={...process.env,VITE_APP_DESTINO:'alumno'};const r=spawnSync('vite',['--configLoader','runner'],{stdio:'inherit',shell:true,env});process.exit(r.status??1);\"",
    "dev:docente": "node --input-type=module -e \"import {spawnSync} from 'node:child_process';const env={...process.env,VITE_APP_DESTINO:'docente'};const r=spawnSync('vite',['--configLoader','runner'],{stdio:'inherit',shell:true,env});process.exit(r.status??1);\"",
    "build": "node ../../node_modules/@typescript/native/bin/tsc --noEmit --composite false --incremental false -p tsconfig.json --pretty false && node ../../scripts/vite-build-safe.mjs --configLoader runner",
    "build:alumno": "node --input-type=module -e \"import {spawnSync} from 'node:child_process';const env={...process.env,VITE_APP_DESTINO:'alumno'};const r=spawnSync('npm',['run','build','--','--outDir','dist-alumno'],{stdio:'inherit',shell:true,env});process.exit(r.status??1);\"",
    "build:docente": "node --input-type=module -e \"import {spawnSync} from 'node:child_process';const env={...process.env,VITE_APP_DESTINO:'docente'};const r=spawnSync('npm',['run','build','--','--outDir','dist-docente'],{stdio:'inherit',shell:true,env});process.exit(r.status??1);\" && node ../../scripts/verify-docente-bundle.mjs --dist dist-docente && node ../../scripts/wcag-guard.mjs",
    "typecheck": "node ../../node_modules/@typescript/native/bin/tsc --noEmit --composite false --incremental false -p tsconfig.json --pretty false",
    "preview": "vite preview --configLoader runner",
    "preview:alumno": "vite preview --configLoader runner --outDir dist-alumno",
    "preview:docente": "vite preview --configLoader runner --outDir dist-docente",
    "test": "vitest run --configLoader runner",
    "test:coverage": "vitest run --configLoader runner --coverage --pool=forks --maxWorkers=8 --reporter=verbose",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" vite.config.ts --max-warnings=0"
  },
  "dependencies": {
    "@react-oauth/google": "^0.13.5",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-mkcert": "^2.1.0"
  }
}
