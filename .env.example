# Core
NODE_ENV=development

# Backend API
PUERTO_API=4000
MONGODB_URI=mongodb://localhost:27017/evaluapro
MONGODB_URI_DEV=mongodb://localhost:27017/evaluapro_dev
MONGODB_URI_PROD=mongodb://localhost:27017/evaluapro_prod
MONGODB_URI_TEST=mongodb://localhost:27017/evaluapro_test
BACKEND_DATA_DIR_DEV=./apps/backend/data/examenes_dev
BACKEND_DATA_DIR_PROD=./apps/backend/data/examenes_prod
JWT_SECRETO=replace_with_secure_secret
JWT_EXPIRA_HORAS=8
REFRESH_TOKEN_DIAS=30
CORS_ORIGENES=http://localhost:5173,http://localhost:4173
DOMINIOS_CORREO_PERMITIDOS=

# Portal sync
PORTAL_ALUMNO_URL=http://localhost:8080/api/portal
PORTAL_ALUMNO_API_KEY=replace_with_portal_api_key
PORTAL_API_KEY=replace_with_portal_api_key
CODIGO_ACCESO_HORAS=12

# Feature flags (canary)
FEATURE_OMR_PIPELINE_V2=0
EXAMEN_PDF_ENGINE=playwright-html-v1
PLAYWRIGHT_BROWSER_CHANNEL=msedge
PLAYWRIGHT_CHROMIUM_EXECUTABLE=

# Compliance / privacidad
COMPLIANCE_MODE=private
DATA_RETENTION_DEFAULT_DAYS=40
DATA_PURGE_CRON=0 3 * * *
AUDIT_LOG_IMMUTABLE=true
DPO_CONTACT_EMAIL=privacidad@example.invalid
LEGAL_NOTICE_VERSION=2026.02
SUPERADMIN_GOOGLE_EMAILS=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_WEBHOOK_MAX_EDAD_SEGUNDOS=300
MERCADOPAGO_WEBHOOK_FIRMA_ESTRICTA=true
COBRANZA_MONTO_TOLERANCIA_PCT=0.03
COBRANZA_MONTO_TOLERANCIA_ABS=1
LICENCIA_JWT_SECRETO=replace_with_license_secret
LICENCIA_JWT_KID_ACTIVO=
LICENCIA_JWT_LLAVE_PRIVADA_PEM=
LICENCIA_JWT_LLAVE_PUBLICA_PEM=
LICENCIA_JWT_LLAVES_PUBLICAS_JSON=
LICENCIA_JWT_PERMITIR_LEGACY_HS256=true
LICENCIA_HEARTBEAT_HORAS=12
LICENCIA_GRACIA_OFFLINE_DIAS=7
COBRANZA_AUTOMATICA_INTERVAL_MIN=30
COBRANZA_DIAS_SUSPENSION_PARCIAL=3
COBRANZA_DIAS_SUSPENSION_TOTAL=10
NOTIFICACIONES_WEBHOOK_URL=
NOTIFICACIONES_WEBHOOK_TOKEN=

# Frontend
VITE_API_BASE_URL=http://localhost:4000/api
VITE_PORTAL_BASE_URL=http://localhost:8080/api/portal
VITE_APP_DESTINO=docente
VITE_HTTPS=false

# OpenAI automation (optional)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Dashboard local (evita falsos errores durante bootstrap de servicios)
# Recomendado en Windows con Docker: 60000 (60s)
DASHBOARD_HEALTH_WARMUP_MS=60000

# OMR reliability (safe defaults)
OMR_AUTO_FORCE_ALL_PAGES=0
OMR_AUTO_HARDSTOP_CONF_MAX=0.30
OMR_AUTO_HARDSTOP_AMBIGUAS_MIN=0.85
OMR_AUTO_HARDSTOP_DETECCION_MAX=0.35
