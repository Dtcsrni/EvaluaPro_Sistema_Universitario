{
  "version": 2,
  "groups": {
    "backend": {
      "paths": [
        "apps/backend/**",
        "omr_samples_tv*/**"
      ],
      "commands": [
        "npm -C apps/backend run lint",
        "npm -C apps/backend run typecheck",
        "npm run test:backend:ci",
        "npm -C apps/backend run build"
      ]
    },
    "backend_omr": {
      "paths": [
        "apps/backend/src/modulos/modulo_escaneo_omr/**",
        "apps/backend/tests/**/*omr*",
        "apps/backend/tests/archivoTemporalOmr.test.ts",
        "apps/backend/tests/integracion/qrEscaneoOmr.test.ts",
        "apps/backend/tests/integracion/omrJobsWorkflow.test.ts",
        "omr_samples_tv*/**"
      ],
      "commands": [
        "npm run test:omr:canonical:gate:ci"
      ]
    },
    "backend_docente_flow": {
      "paths": [
        "apps/backend/src/modulos/modulo_autenticacion/**",
        "apps/backend/src/modulos/modulo_admin_docentes/**",
        "apps/backend/src/modulos/modulo_alumnos/**",
        "apps/backend/src/modulos/modulo_evaluaciones/**",
        "apps/backend/src/modulos/modulo_vinculacion_entrega/**",
        "apps/backend/tests/integracion/flujoDocenteAlumnoProduccionLikeE2E.test.ts"
      ],
      "commands": [
        "npm run test:dataset-prodlike:ci",
        "npm run test:e2e:docente-alumno:ci"
      ]
    },
    "backend_grade": {
      "paths": [
        "apps/backend/src/modulos/modulo_calificacion/**",
        "apps/backend/tests/**/*calificacion*",
        "apps/backend/tests/**/*Calificacion*"
      ],
      "commands": [
        "npm run test:global-grade:ci"
      ]
    },
    "backend_pdf": {
      "paths": [
        "apps/backend/src/modulos/modulo_generacion_pdf/**",
        "apps/backend/tests/**/*pdf*",
        "apps/backend/tests/**/*Pdf*",
        "apps/backend/tests/integracion/pdfImpresionContrato.test.ts"
      ],
      "commands": [
        "npm run test:pdf-print:ci"
      ]
    },
    "backend_privacy": {
      "paths": [
        "apps/backend/src/modulos/modulo_alumnos/**",
        "apps/backend/src/modulos/modulo_admin_docentes/**",
        "apps/backend/src/modulos/modulo_papelera/**",
        "apps/backend/src/modulos/modulo_compliance/**",
        "apps/backend/tests/**/*privacidad*",
        "apps/backend/tests/**/*retencion*",
        "apps/backend/tests/**/*dsr*"
      ],
      "commands": [
        "npm run test:compliance:dsr-flow",
        "npm run compliance:evidence:generate"
      ]
    },
    "frontend": {
      "paths": [
        "apps/frontend/**",
        "client/**",
        "scripts/wcag-guard.mjs",
        "scripts/tests/ui-contrast-audit.mjs",
        "scripts/tests/wcag-guard.contract.test.mjs",
        "docs/WCAG_UI_POLICY.md"
      ],
      "commands": [
        "npm -C apps/frontend run lint",
        "npm -C apps/frontend run typecheck",
        "npm run test:frontend:ci",
        "npm run test:client:proyectos:ci",
        "npm run test:ux-quality:ci",
        "npm run test:frontend:coverage:min",
        "npm -C apps/frontend run build"
      ]
    },
    "portal": {
      "paths": [
        "apps/portal_alumno_cloud/**"
      ],
      "commands": [
        "npm -C apps/portal_alumno_cloud run lint",
        "npm -C apps/portal_alumno_cloud run typecheck",
        "npm run test:portal:ci",
        "npm -C apps/portal_alumno_cloud run test:coverage",
        "npm -C apps/portal_alumno_cloud run build"
      ]
    },
    "classroom": {
      "paths": [
        "apps/backend/src/**/*classroom*",
        "apps/backend/src/**/*Classroom*",
        "apps/backend/tests/**/*classroom*",
        "apps/backend/tests/**/*Classroom*",
        "apps/frontend/src/**/*classroom*",
        "apps/frontend/src/**/*Classroom*",
        "apps/frontend/tests/**/*classroom*",
        "apps/frontend/tests/**/*Classroom*"
      ],
      "commands": [
        "npm run test:classroom:audit:ci"
      ]
    },
    "installer": {
      "paths": [
        "scripts/installer-burn/**",
        "scripts/build-msi.ps1",
        "scripts/generate-installer-hashes.ps1",
        "scripts/generate-installer-release-manifest.ps1",
        "scripts/sign-installer-artifacts.ps1",
        "scripts/Install-EvaluaPro.ps1",
        "scripts/runtime-env.mjs",
        "scripts/start-docente-native.mjs",
        "packaging/**",
        "config/installer-*.json",
        "config/update-config.json"
      ],
      "commands": [
        "npm run test:installer-hub:contract",
        "npm run test:wix:policy"
      ]
    },
    "release": {
      "paths": [
        "scripts/release/**",
        ".github/workflows/ci-installer-windows.yml",
        ".github/workflows/package.yml",
        ".github/workflows/release-beta.yml",
        ".github/workflows/release-stable-gate.yml"
      ],
      "commands": [
        "npm run test:release:policy",
        "npm run test:ruleset:policy",
        "npm run test:security:policy"
      ]
    },
    "ci_tooling": {
      "paths": [
        "package.json",
        "scripts/testing/**",
        "scripts/tests/ci-workflow-contract.test.mjs",
        "scripts/tests/affected-ci-resolver.test.mjs",
        ".github/workflows/ci*.yml",
        "ci/**"
      ],
      "commands": [
        "npm run pipeline:contract:check",
        "npm run test:security:policy"
      ]
    },
    "performance": {
      "paths": [
        "apps/backend/src/modulos/modulo_analiticas/**",
        "scripts/perf/**",
        "scripts/perf-check.mjs",
        "scripts/perf-check-business.mjs",
        "scripts/perf-collect.ts",
        "scripts/perf-collect-business.ts",
        "scripts/tests/perf-business-config.contract.test.mjs",
        "docs/performance/**",
        "apps/backend/prisma.config.mjs"
      ],
      "commands": [
        "npm run perf:check",
        "npm run perf:check:business"
      ]
    },
    "architecture": {
      "paths": [
        "scripts/clean-architecture-check.mjs",
        "scripts/tests/clean-architecture*.test.mjs",
        "docs/architecture/**"
      ],
      "commands": [
        "npm run qa:clean-architecture:check"
      ]
    },
    "qa_manifest": {
      "paths": [
        "scripts/testing/generar-qa-manifest.mjs",
        "scripts/tests/qa-manifest*.test.mjs"
      ],
      "commands": [
        "npm run test:qa:manifest"
      ]
    },
    "docs": {
      "paths": [
        "docs/**"
      ],
      "commands": [
        "npm run docs:generate",
        "npm run docs:check",
        "npm run diagramas:check",
        "npm run diagramas:render",
        "npm run diagramas:consistencia:check",
        "npm run routes:check"
      ]
    },
    "compliance": {
      "paths": [
        "docs/legal/**",
        "scripts/compliance/**"
      ],
      "commands": [
        "npm run test:compliance:legal-docs",
        "npm run test:compliance:pii",
        "npm run test:compliance:retention"
      ]
    },
    "shared": {
      "paths": [
        "package-lock.json",
        "docker-compose.yml",
        "apps/backend/src/compartido/**",
        "scripts/retry.mjs",
        "tsconfig.base.json",
        "vitest.base.ts"
      ],
      "commands": [
        "npm run test:coverage:exclusions:debt"
      ],
      "escalate": "full-core"
    }
  },
  "gates": {
    "flujo-docente-check": {
      "groups": ["backend_docente_flow"]
    },
    "dataset-prodlike-check": {
      "groups": ["backend_docente_flow", "backend_grade"]
    },
    "omr-tv-extended-gate": {
      "groups": ["backend_omr"]
    },
    "docente-alumno-e2e-check": {
      "groups": ["backend_docente_flow"]
    },
    "global-grade-check": {
      "groups": ["backend_grade"]
    },
    "pdf-print-check": {
      "groups": ["backend_pdf"]
    },
    "classroom-audit-check": {
      "groups": ["classroom"]
    },
    "perf-check": {
      "groups": ["performance"]
    },
    "perf-business-check": {
      "groups": ["performance"]
    },
    "clean-architecture-check": {
      "groups": ["architecture"]
    },
    "ux-visual-check": {
      "groups": ["frontend"]
    },
    "qa-manifest": {
      "groups": ["qa_manifest"]
    },
    "dsr-flow-test": {
      "groups": ["backend_privacy", "compliance"]
    },
    "compliance-evidence": {
      "groups": ["backend_privacy", "compliance", "portal"]
    }
  },
  "jobs": {
    "core_contract_docs_gov": {
      "groups": ["docs", "installer", "release", "shared", "ci_tooling"]
    },
    "core_backend_portal": {
      "groups": ["backend", "portal", "classroom", "shared"]
    },
    "core_frontend": {
      "groups": ["frontend", "shared"]
    },
    "core_security_compliance": {
      "groups": ["backend", "portal", "compliance", "docs", "shared"]
    },
    "ext_funcionales": {
      "gates": [
        "flujo-docente-check",
        "dataset-prodlike-check",
        "omr-tv-extended-gate",
        "docente-alumno-e2e-check",
        "global-grade-check",
        "pdf-print-check",
        "ux-visual-check"
      ]
    },
    "ext_perf_arquitectura": {
      "gates": [
        "perf-check",
        "perf-business-check",
        "clean-architecture-check"
      ]
    },
    "ext_compliance_evidencia": {
      "gates": [
        "qa-manifest",
        "dsr-flow-test",
        "compliance-evidence"
      ]
    }
  }
}
