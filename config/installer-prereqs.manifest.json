{
  "version": "1.0.0",
  "defaultProfile": "docente-local",
  "profiles": [
    {
      "profileId": "saas-completo",
      "description": "Prerequisitos para despliegue local SaaS completo",
      "prerequisites": [
        "Node.js",
        "Docker Runtime Windows"
      ]
    },
    {
      "profileId": "docente-local",
      "description": "Prerequisitos para operacion docente local completa",
      "prerequisites": [
        "Node.js",
        "Docker Runtime Windows"
      ]
    }
  ],
  "prerequisites": [
    {
      "name": "Node.js",
      "version": "24.x",
      "downloadUrl": "https://nodejs.org/dist/latest-v24.x/node-v24.11.1-x64.msi",
      "sha256": "DYNAMIC_FROM_URL",
      "sha256Url": "https://nodejs.org/dist/latest-v24.x/SHASUMS256.txt",
      "sha256Pattern": "node-v24.11.1-x64.msi",
      "silentArgs": "/qn /norestart",
      "detectRule": {
        "type": "node_major",
        "minMajor": 24
      }
    },
    {
      "name": "Docker Runtime Windows",
      "version": "wsl2-engine-default",
      "downloadUrl": "https://learn.microsoft.com/windows/wsl/install",
      "sha256": "GUIDED_BOOTSTRAP",
      "sha256Url": "",
      "sha256Pattern": "",
      "silentArgs": "bootstrap-guided",
      "detectRule": {
        "type": "docker_runtime_windows"
      }
    }
  ]
}
