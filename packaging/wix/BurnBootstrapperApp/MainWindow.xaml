<!--
  MainWindow.xaml
  Wizard visual del Installer Hub con pasos operativos, UI moderna y trazabilidad por estado.
-->
<Window x:Class="EvaluaPro.BurnBootstrapperApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="EvaluaPro Installer Hub"
        Icon="pack://application:,,,/assets/evaluapro-installer-logo.png"
        Width="1320"
        Height="880"
        MinWidth="980"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#FF0B1220"
        FontFamily="Segoe UI, Segoe UI Variable Text, Aptos, Arial"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        AutomationProperties.Name="EvaluaPro Installer Hub">
    <Window.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FF0B1220" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FF142237" />
        <SolidColorBrush x:Key="SubtleSurfaceBrush" Color="#FF1A2B42" />
        <SolidColorBrush x:Key="BorderBrushNeutral" Color="#FF526981" />
        <SolidColorBrush x:Key="TextBrush" Color="#FFF8FAFC" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#FFCAD5E2" />
        <SolidColorBrush x:Key="TermsTextBrush" Color="#FFE6EDF5" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#FF2DD4BF" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF2563EB" />
        <!-- Tono semántico conservado para estados de éxito calculados en code-behind. -->
        <SolidColorBrush x:Key="WarningBrush" Color="#B45309" />
        <SolidColorBrush x:Key="ErrorBrush" Color="#B42318" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#15803D" />
        <SolidColorBrush x:Key="FocusBrush" Color="#FF2563EB" />
        <DropShadowEffect x:Key="CardShadow" BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.24" Color="#FF000000" />
        <SolidColorBrush x:Key="SecondaryButtonBrush" Color="#FF263B52" />
        <SolidColorBrush x:Key="PrimaryButtonBrush" Color="#FF0F766E" />

        <Style x:Key="StepCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushNeutral}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Effect" Value="{StaticResource CardShadow}" />
        </Style>

        <Style x:Key="PanelCardStyle" TargetType="Border" BasedOn="{StaticResource StepCardStyle}">
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Background" Value="{StaticResource SubtleSurfaceBrush}" />
        </Style>

        <Style x:Key="StatusBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="Background" Value="#FF102037" />
            <Setter Property="BorderBrush" Value="#FF526981" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="BrandTileStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,8,8,0" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushNeutral}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="IconPlateStyle" TargetType="Border">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="#FF1B4961" />
            <Setter Property="BorderBrush" Value="#FF526981" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="HelpTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,1,0,0" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="BorderBrush" Value="#FF70849A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FF0C1728" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource FocusBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="BorderBrush" Value="#FF70849A" />
            <Setter Property="Background" Value="#FF0C1728" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource FocusBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HighContrastFocusVisual" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="2" Stroke="{StaticResource FocusBrush}" StrokeThickness="2" StrokeDashArray="1 2" SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource HighContrastFocusVisual}" />
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#FF0C1728" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="MinHeight" Value="40" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#FF263B52" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FF0F766E" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Expander nativo: el encabezado explícito evita plantillas deferred incompatibles. -->

        <Style TargetType="ListView">
            <Setter Property="BorderBrush" Value="#FF70849A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FF0C1728" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource HighContrastFocusVisual}" />
        </Style>

        <Style TargetType="ListViewItem">
            <Setter Property="Background" Value="#FF0C1728" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FF263B52" />
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource FocusBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Background" Value="#E5E7EB" />
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="MaxWidth" Value="360" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Background" Value="#111827" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#374151" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HasDropShadow" Value="True" />
        </Style>

        <ControlTemplate x:Key="AccessibleButtonTemplate" TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6"
                    Opacity="{TemplateBinding Opacity}">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  Margin="{TemplateBinding Padding}"
                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                  TextElement.FontWeight="{TemplateBinding FontWeight}"
                                  RecognizesAccessKey="True" />
            </Border>
        </ControlTemplate>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushNeutral}" />
            <Setter Property="Background" Value="{StaticResource SecondaryButtonBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template" Value="{StaticResource AccessibleButtonTemplate}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF334E68" />
                    <Setter Property="BorderBrush" Value="#38BDF8" />
                    <Setter Property="Effect" Value="{StaticResource CardShadow}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.78" />
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderThickness" Value="2" />
                    <Setter Property="BorderBrush" Value="{StaticResource FocusBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#FF1E293B" />
                    <Setter Property="Foreground" Value="#FFCBD5E1" />
                    <Setter Property="BorderBrush" Value="#FF64748B" />
                    <Setter Property="Opacity" Value="0.7" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Base tipográfica única: Segoe UI TrueType en Windows; fallback variable de alta resolución. -->
        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="14.5" />
            <Setter Property="LineHeight" Value="22" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="BorderBrush" Value="#2DD4BF" />
            <Setter Property="Background" Value="{StaticResource PrimaryButtonBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#14B8A6" />
                    <Setter Property="BorderBrush" Value="#5EEAD4" />
                    <Setter Property="Effect" Value="{StaticResource CardShadow}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#115E59" />
                    <Setter Property="Opacity" Value="0.92" />
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderThickness" Value="2" />
                    <Setter Property="BorderBrush" Value="{StaticResource FocusBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#334155" />
                    <Setter Property="Foreground" Value="#94A3B8" />
                    <Setter Property="BorderBrush" Value="#475569" />
                    <Setter Property="Opacity" Value="0.75" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="BorderBrush" Value="#F87171" />
            <Setter Property="Background" Value="#DC2626" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="Bold" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EF4444" />
                    <Setter Property="BorderBrush" Value="#FCA5A5" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#991B1B" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="18" Background="{StaticResource AppBackgroundBrush}"
          SnapsToDevicePixels="True">
        <Grid x:Name="ContentGrid" KeyboardNavigation.TabNavigation="Cycle">
            <Grid.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="HeaderCard" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.32" />
                            <DoubleAnimation Storyboard.TargetName="WizardCard" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.42" BeginTime="0:0:0.08" />
                            <DoubleAnimation Storyboard.TargetName="FooterCard" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.32" BeginTime="0:0:0.16" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Grid.Triggers>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="HeaderCard" Style="{StaticResource StepCardStyle}" Padding="10,8" Margin="0,0,0,6" Opacity="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="InstallerLogoFrame" Width="54" Height="54" CornerRadius="10" Background="#FF0C1728" BorderBrush="#FF526981" BorderThickness="1" Padding="4" Margin="0,0,12,0" ToolTip="Identidad EvaluaPro del instalador.">
                        <Image x:Name="InstallerLogoImage" Source="pack://application:,,,/assets/evaluapro-installer-logo.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Logo EvaluaPro Installer Hub" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="EvaluaPro Installer Hub" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                        <TextBlock x:Name="BrandStatementTextBlock" Margin="0,1,0,0" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Text="Instala, actualiza, repara o desinstala EvaluaPro." TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource StatusBadgeStyle}">
                            <TextBlock x:Name="HubVersionTextBlock" AutomationProperties.AutomationId="HubVersionTextBlock" Text="v-" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                        </Border>
                        <Border Style="{StaticResource StatusBadgeStyle}" Visibility="Collapsed">
                            <TextBlock x:Name="BrandVersionBadgeTextBlock" Text="Burn + MSI + helper" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="WizardCard" Grid.Row="1" Style="{StaticResource StepCardStyle}" Padding="12,10" Opacity="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid x:Name="StepperHost" Margin="0,0,0,10" AutomationProperties.Name="Progreso del asistente" AutomationProperties.LiveSetting="Polite">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="WorkflowProgressTextBlock" Text="Paso 1 de 5 · Términos" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" AutomationProperties.LiveSetting="Polite" />
                        <ProgressBar x:Name="WorkflowProgressBar" Grid.Row="1" Minimum="0" Maximum="5" Value="1" Height="4" Margin="0,6,0,0" AutomationProperties.Name="Progreso del asistente" AutomationProperties.HelpText="Indica la etapa actual de cinco." />
                    </Grid>

                    <!-- Estados internos conservados para la lógica y las pruebas de contrato; el indicador visible es compacto. -->
                    <StackPanel x:Name="LegacyStepperStateHost" Grid.Row="0" Visibility="Collapsed" KeyboardNavigation.IsTabStop="False">
                        <Border x:Name="TermsStepBorder" Style="{StaticResource StatusBadgeStyle}" MinWidth="118">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path x:Name="TermsStepIcon" Width="14" Height="14" Margin="0,0,6,0" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" SnapsToDevicePixels="True" />
                                <TextBlock x:Name="TermsStepTextBlock" Text="1 Términos · activo" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Rectangle x:Name="StepConnectorTermsPrepare" Width="16" Height="2" Fill="#D9E2EA" VerticalAlignment="Center" Margin="-4,0,4,0" RadiusX="1" RadiusY="1" />
                        <Border x:Name="PrepareStepBorder" Style="{StaticResource StatusBadgeStyle}" MinWidth="118" Background="#FF20344C" BorderBrush="{StaticResource BorderBrushNeutral}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path x:Name="PrepareStepIcon" Width="14" Height="14" Margin="0,0,6,0" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" SnapsToDevicePixels="True" />
                                <TextBlock x:Name="PrepareStepTextBlock" Text="2 Preparar · pendiente" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Rectangle x:Name="StepConnectorPrepareReview" Width="16" Height="2" Fill="#D9E2EA" VerticalAlignment="Center" Margin="-4,0,4,0" RadiusX="1" RadiusY="1" />
                        <Border x:Name="ReviewStepBorder" Style="{StaticResource StatusBadgeStyle}" MinWidth="118" Background="#FF20344C" BorderBrush="{StaticResource BorderBrushNeutral}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path x:Name="ReviewStepIcon" Width="14" Height="14" Margin="0,0,6,0" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" SnapsToDevicePixels="True" />
                                <TextBlock x:Name="ReviewStepTextBlock" Text="3 Revisar · pendiente" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Rectangle x:Name="StepConnectorReviewExecute" Width="16" Height="2" Fill="#D9E2EA" VerticalAlignment="Center" Margin="-4,0,4,0" RadiusX="1" RadiusY="1" />
                        <Border x:Name="ExecuteStepBorder" Style="{StaticResource StatusBadgeStyle}" MinWidth="118" Background="#FF20344C" BorderBrush="{StaticResource BorderBrushNeutral}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path x:Name="ExecuteStepIcon" Width="14" Height="14" Margin="0,0,6,0" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" SnapsToDevicePixels="True" />
                                <TextBlock x:Name="ExecuteStepTextBlock" Text="4 Ejecutar · pendiente" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Rectangle x:Name="StepConnectorExecuteResult" Width="16" Height="2" Fill="#D9E2EA" VerticalAlignment="Center" Margin="-4,0,4,0" RadiusX="1" RadiusY="1" />
                        <Border x:Name="ResultStepBorder" Style="{StaticResource StatusBadgeStyle}" MinWidth="118" Background="#FF20344C" BorderBrush="{StaticResource BorderBrushNeutral}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path x:Name="ResultStepIcon" Width="14" Height="14" Margin="0,0,6,0" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" SnapsToDevicePixels="True" />
                                <TextBlock x:Name="ResultStepTextBlock" Text="5 Resultado · pendiente" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border x:Name="StatusCardBorder" Grid.Row="1" Padding="10,7" CornerRadius="10" Background="#FF14536D" BorderBrush="#FF38DDF5" BorderThickness="1" Margin="0,0,0,5" Effect="{StaticResource CardShadow}" AutomationProperties.LiveSetting="Polite">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="StatusVisualPlate" Style="{StaticResource IconPlateStyle}" Width="30" Height="30" Margin="0,0,8,0" ToolTip="Indicador visual del estado general de la operación.">
                                <Path x:Name="StatusVisualIcon" Data="M6,22 L15,31 L34,12" Stroke="{StaticResource PrimaryBrush}" StrokeThickness="2.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Margin="6" />
                            </Border>
                            <!-- Animated Circular Vector Process Spinner -->
                            <Grid x:Name="StatusSpinner" Grid.Column="1" Margin="0,0,6,0" VerticalAlignment="Center" Width="16" Height="16" Visibility="Collapsed">
                                <Ellipse Stroke="#E5E7EB" StrokeThickness="2" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Path Stroke="{Binding ElementName=StatusBadgeTextBlock, Path=Foreground}" StrokeThickness="2" StrokeStartLineCap="Round" Width="16" Height="16" Data="M8,1 A7,7 0 0 1 15,8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path.RenderTransform>
                                        <RotateTransform x:Name="SpinnerTransform" CenterX="8" CenterY="8" />
                                    </Path.RenderTransform>
                                    <Path.Triggers>
                                        <EventTrigger RoutedEvent="Path.Loaded">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="SpinnerTransform" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:1.2" RepeatBehavior="Forever" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Path.Triggers>
                                </Path>
                            </Grid>
                            <TextBlock x:Name="StatusBadgeTextBlock" Grid.Column="2" Text="Estado activo" FontWeight="Bold" FontSize="13" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                <TextBlock x:Name="StatusTextBlock" AutomationProperties.AutomationId="StatusTextBlock" AutomationProperties.LiveSetting="Polite" Text="Analizando prerequisitos..." Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="StatusHintTextBlock" AutomationProperties.LiveSetting="Polite" Text="La operación todavía no termina." Foreground="{StaticResource MutedTextBrush}" FontSize="13" Margin="0,1,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="LiveExplanationBorder" Grid.Row="2" Margin="0,0,0,6" Padding="8,4" CornerRadius="8" Background="#FF1A2B42" BorderBrush="#FF526981" BorderThickness="1" ToolTip="Explica qué está pasando y qué espera el asistente en este momento.">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path x:Name="LiveExplanationIcon" Width="14" Height="14" Data="M9,2 A7,7 0 1 1 8.99,2 M9,6 L9,10 M9,13 L9,13.5" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="LiveExplanationTitleTextBlock" Text="Qué está pasando" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextBrush}" AutomationProperties.LiveSetting="Polite" />
                                <TextBlock x:Name="LiveExplanationTextBlock" Text="El asistente está esperando que completes el paso visible antes de continuar." FontSize="13" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,1,0,0" AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid x:Name="StepHost" Grid.Row="3">
                        <!-- Pantalla Independiente de Términos y Condiciones -->
                        <Grid x:Name="TermsStepPanel" Visibility="Visible">
