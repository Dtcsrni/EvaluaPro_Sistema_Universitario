                                                                </StackPanel>
                                                            </ToolTip>
                                                        </TextBox.ToolTip>
                                                    </TextBox>
                                                    <StackPanel Margin="0,8,0,0">
                                                        <CheckBox x:Name="DesktopShortcutsCheckBox" Content="Crear acceso directo en el Escritorio" IsChecked="True" Margin="0,0,0,4" FontSize="12" ToolTip="Crea accesos directos en el escritorio." AutomationProperties.Name="Crear accesos en escritorio" TabIndex="3" />
                                                        <CheckBox x:Name="StartMenuShortcutsCheckBox" Content="Crear acceso directo en el Menú Inicio" IsChecked="True" Margin="0,0,0,4" FontSize="12" ToolTip="Crea accesos directos en el menú Inicio." AutomationProperties.Name="Crear accesos en menú Inicio" TabIndex="4" />
                                                        <CheckBox x:Name="ExportDataCheckBox" Content="Respaldar mis datos localmente antes de desinstalar" IsChecked="True" Margin="0,0,0,4" FontSize="12" ToolTip="Guarda una copia privada en EvaluaPro\Backups antes de desinstalar." Visibility="Collapsed" AutomationProperties.Name="Respaldar datos" AutomationProperties.AutomationId="ExportDataCheckBox" TabIndex="5" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
