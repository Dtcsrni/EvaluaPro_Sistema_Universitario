                                <Border Style="{StaticResource PanelCardStyle}" Grid.Column="2">
                                    <StackPanel>
                                        <TextBlock Text="Resumen de instalación" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Style="{StaticResource HelpTextStyle}" Text="Parámetros confirmados antes de iniciar." Margin="0,2,0,8" FontSize="12.5" />

                                        <Border Margin="0,0,0,8" Padding="12,10" CornerRadius="8" Background="#FF1C3B54" BorderBrush="#FF526981" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="• EDICIÓN SELECCIONADA" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                                <TextBlock x:Name="EditionVersionTextBlock" AutomationProperties.AutomationId="EditionVersionTextBlock" Text="EvaluaPro Docente Local" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,2,0,6" />

                                                <TextBlock Text="• BASE DE DATOS LOCAL" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                                <TextBlock Text="SQLite Aislada (evaluapro.db)" FontSize="12.5" Foreground="{StaticResource TextBrush}" Margin="0,2,0,6" />

