                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock x:Name="ModeImpactTitleTextBlock" Text="Instalar o actualizar" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                                            <TextBlock x:Name="ModeImpactTextBlock" Margin="0,2,0,0" Text="Configura runtime nativo, escribe configuración operativa local y crea accesos directos." TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource TextBrush}" LineHeight="17" />
                                                            <TextBlock x:Name="ModeImpactChecklistTextBlock" Margin="0,2,0,0" Text="• Runtime Node aislado · Base SQLite local (evaluapro.db) · Accesos directos" TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource MutedTextBrush}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <Grid Margin="0,2,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel x:Name="FlavorPanel">
