                                                <TextBlock x:Name="StageSummaryTitleTextBlock" />
                                                <TextBlock x:Name="StageSummaryTextBlock" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                            </Border>
                        </Grid>

                        </ScrollViewer>
                        <Grid x:Name="ExecuteStepPanel" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.92*" />
                                <ColumnDefinition Width="1.08*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock x:Name="WorkflowHeaderTitleTextBlock" Text="Ejecutar operación" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                                    <TextBlock x:Name="WorkflowHeaderHintTextBlock" Style="{StaticResource HelpTextStyle}" Text="Desplegando runtime aislado, base de datos local y accesos del sistema." FontSize="12.5" Margin="0,2,0,0" />
                                    <ProgressBar x:Name="InstallProgressBar" Height="14" Margin="0,14,0,10" Minimum="0" Maximum="100" ToolTip="Progreso general de la operación." AutomationProperties.Name="Progreso general de la operación">
