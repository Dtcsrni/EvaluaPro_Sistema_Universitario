                                                <TextBlock Text="• ACCESOS DIRECTOS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                                <TextBlock Text="Escritorio y Menú Inicio" FontSize="12.5" Foreground="{StaticResource TextBrush}" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Estimación Adaptativa de Tiempo -->
                                        <Border Padding="12,10" CornerRadius="8" Background="#FF143A32" BorderBrush="#FF2DD4BF" BorderThickness="1">
