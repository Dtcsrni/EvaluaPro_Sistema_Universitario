                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Línea de tareas" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
