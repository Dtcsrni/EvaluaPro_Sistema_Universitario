                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid x:Name="ResultStepPanel" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.9*" />
                                <ColumnDefinition Width="1.1*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,12,0">
                                <ScrollViewer x:Name="ResultSummaryScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Desplazamiento del resumen del resultado">
                                <StackPanel>
                                    <TextBlock Text="Resultado de la operación" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Text="Estado final, verificación de integridad y siguientes pasos." Style="{StaticResource HelpTextStyle}" FontSize="12.5" Margin="0,2,0,0" />
                                    <Border x:Name="ResultFailureSummaryBorder" Margin="0,12,0,0" Padding="12" CornerRadius="8" Background="#FF4A1D2B" BorderBrush="#FFFC8490" BorderThickness="1" Visibility="Collapsed">
                                        <StackPanel>
                                            <TextBlock x:Name="ResultFailureTitleTextBlock" FontSize="14" FontWeight="Bold" Foreground="#FFE8EE" TextWrapping="Wrap" AutomationProperties.AutomationId="ResultFailureTitleTextBlock" />
                                            <TextBlock x:Name="ResultFailureTextBlock" Margin="0,5,0,0" FontSize="12.5" Foreground="#FFD6E2" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <Border Margin="0,12,0,0" Padding="14,12" CornerRadius="8" Background="#FF0F4A3E" BorderBrush="#FF2DD4BF" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="{Binding ElementName=StatusBadgeTextBlock, Path=Text}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource PrimaryBrush}" />
                                            <TextBlock Text="{Binding ElementName=StatusTextBlock, Path=Text}" Margin="0,4,0,0" FontSize="15.5" FontWeight="Bold" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding ElementName=StatusHintTextBlock, Path=Text}" Margin="0,4,0,0" FontSize="12.5" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <Border Margin="0,10,0,0" Padding="12,9" CornerRadius="8" Background="#FF143A32" BorderBrush="#FF2DD4BF" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="• VERIFICACIÓN DE INTEGRIDAD BINARIA" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                            <TextBlock x:Name="InstallVerificationTextBlock" Text="Pendiente: se verificará al finalizar la operación." FontSize="12" Margin="0,3,0,0" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" AutomationProperties.Name="Verificación CRC de la instalación" />
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Path Data="M2,9 L12,3 L22,9 L12,15 Z M6,12 V17 C9,20 15,20 18,17 V12" Width="20" Height="20" Stretch="Uniform" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Gracias por elegir EvaluaPro." FontSize="14.5" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" />
                                    </StackPanel>
                                </StackPanel>
                                </ScrollViewer>
                            </Border>
                            <Border Style="{StaticResource PanelCardStyle}" Grid.Column="1">
                                <ScrollViewer x:Name="ResultEvidenceScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Desplazamiento de la evidencia técnica">
                                <StackPanel>
                                    <TextBlock Text="Evidencia técnica" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Text="Rutas y bitácoras para soporte técnico docente." Style="{StaticResource HelpTextStyle}" FontSize="12.5" Margin="0,2,0,6" />
                                    <Border Margin="0,0,0,8" Padding="12,8" CornerRadius="8" Background="#FF0F1B2D" BorderBrush="#FF526981" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="BITÁCORA DE SESIÓN" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                            <TextBox Margin="0,2,0,0"
                                                     Text="%ProgramData%\EvaluaPro\installer-hub\logs"
                                                     IsReadOnly="True"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     Foreground="{StaticResource AccentBrush}"
                                                     FontSize="12"
                                                     AutomationProperties.Name="Ruta de bitácoras técnicas" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="Primeros pasos" Margin="0,4,0,0" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                                    <Border Margin="0,4,0,8" Padding="12,8" CornerRadius="8" Background="#FF0F1B2D" BorderBrush="#FF526981" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="• Inicia EvaluaPro desde el icono en tu Escritorio o Menú Inicio." FontSize="12" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,0,0,4" />
                                            <TextBlock Text="• Registra tu perfil docente para crear materias, listas y encuadres." FontSize="12" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,0,0,4" />
                                            <TextBlock Text="• Califica exámenes masivamente mediante lectura óptica (OMR)." FontSize="12" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <Button x:Name="LaunchEvaluaProButton" Content="_Iniciar EvaluaPro ahora" Style="{StaticResource PrimaryButtonStyle}" MinWidth="200" Padding="16,8" Visibility="Collapsed" Click="LaunchEvaluaProButton_OnClick" AutomationProperties.Name="Iniciar EvaluaPro" AutomationProperties.HelpText="Inicia la plataforma nativa EvaluaPro." />
                                </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>

                    <Expander x:Name="LogExpander" Grid.Row="4" Background="#FF18324A" Foreground="{StaticResource TextBrush}" BorderBrush="#4C7894" BorderThickness="1" Header="Bitácora técnica" IsExpanded="False" Margin="0,12,0,0" ToolTip="Detalle técnico para soporte.">
                        <Expander.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="13" />
                            </DataTemplate>
                        </Expander.HeaderTemplate>
                        <TextBox x:Name="LogTextBox"
                                 Height="100"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 IsReadOnly="True"
                                 TextWrapping="NoWrap"
                                 AcceptsReturn="True"
                                 Background="#FF081726"
                                 Foreground="#E2E8F0"
                                 BorderBrush="#FF526981"
                                 Padding="6"
                                 HorizontalScrollBarVisibility="Auto"
                                 VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="Bitácora técnica de instalación"
                                 AutomationProperties.HelpText="Salida técnica de la sesión para soporte."
                                 ToolTip="Bitácora detallada de la sesión." />
                    </Expander>
                </Grid>
            </Border>

            <Border x:Name="FooterCard" Grid.Row="2" Style="{StaticResource StepCardStyle}" Padding="12,10" Margin="0,10,0,0" Opacity="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock x:Name="FooterStatusTextBlock" AutomationProperties.AutomationId="FooterStatusTextBlock" AutomationProperties.LiveSetting="Polite" Text="Listo para guiar la operación." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                        <TextBlock x:Name="FooterNextActionTextBlock" AutomationProperties.LiveSetting="Polite" Text="Acepta los términos para continuar." Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="DetectButton" Content="_Revisar equipo" Style="{StaticResource SecondaryButtonStyle}" MinWidth="130" Margin="0,0,8,0" Click="DetectButton_OnClick" ToolTip="Ejecuta nuevamente la revisión de prerequisitos." AutomationProperties.Name="Revisar equipo" AutomationProperties.HelpText="Ejecuta el diagnóstico de prerequisitos de Windows, Node y archivos locales." TabIndex="20" />
                        <Button x:Name="BackButton" Content="_Atrás" Style="{StaticResource SecondaryButtonStyle}" MinWidth="90" Margin="0,0,8,0" Click="BackButton_OnClick" ToolTip="Vuelve al paso anterior." AutomationProperties.Name="Atrás" AutomationProperties.HelpText="Vuelve al paso anterior del asistente." TabIndex="21" />
                        <Button x:Name="NextButton" Content="_Siguiente" Style="{StaticResource SecondaryButtonStyle}" MinWidth="110" Margin="0,0,8,0" Click="NextButton_OnClick" ToolTip="Avanza al siguiente paso." AutomationProperties.Name="Siguiente" AutomationProperties.HelpText="Avanza al siguiente paso del asistente." TabIndex="22" />
                        <Button x:Name="StartButton" Content="_Continuar" Style="{StaticResource PrimaryButtonStyle}" MinWidth="130" Margin="0,0,8,0" Click="StartButton_OnClick" ToolTip="Inicia la operación seleccionada." AutomationProperties.Name="Iniciar operación seleccionada" AutomationProperties.HelpText="Instala, repara o desinstala EvaluaPro según el modo elegido." TabIndex="23" />
                        <Button x:Name="RestartNowButton" Content="Reiniciar _ahora" Style="{StaticResource DangerButtonStyle}" MinWidth="140" Margin="0,0,8,0" Visibility="Collapsed" Click="RestartNowButton_OnClick" ToolTip="Reinicia Windows para retomar automáticamente la instalación." AutomationProperties.Name="Reiniciar ahora" AutomationProperties.HelpText="Reinicia Windows y registra la reanudación automática del Hub." TabIndex="24" />
                        <Button x:Name="CloseButton" Content="_Cerrar" Style="{StaticResource SecondaryButtonStyle}" Width="100" Click="CloseButton_OnClick" ToolTip="Cierra el asistente." AutomationProperties.Name="Cerrar Installer Hub" AutomationProperties.HelpText="Cierra la ventana si no hay una operación en progreso." TabIndex="25" />
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</Window>
