<!--
  MainWindow.xaml
  Wizard visual del Installer Hub con pasos operativos, UI moderna y trazabilidad por estado.
-->
<Window x:Class="EvaluaPro.BurnBootstrapperApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="EvaluaPro Installer Hub"
        Icon="pack://application:,,,/assets/evaluapro-installer-logo.png"
        Width="1040"
        Height="760"
        MinWidth="980"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#F6F8FA"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AutomationProperties.Name="EvaluaPro Installer Hub">
    <Window.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F6F8FA" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SubtleSurfaceBrush" Color="#F9FAFB" />
        <SolidColorBrush x:Key="BorderBrushNeutral" Color="#D9E2EA" />
        <SolidColorBrush x:Key="TextBrush" Color="#111827" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#526173" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#0F766E" />
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="WarningBrush" Color="#B45309" />
        <SolidColorBrush x:Key="ErrorBrush" Color="#B42318" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#15803D" />

        <Style x:Key="StepCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushNeutral}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style x:Key="PanelCardStyle" TargetType="Border" BasedOn="{StaticResource StepCardStyle}">
            <Setter Property="Padding" Value="14" />
            <Setter Property="Background" Value="{StaticResource SubtleSurfaceBrush}" />
        </Style>

        <Style x:Key="StatusBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="#ECFDF5" />
            <Setter Property="BorderBrush" Value="#A7F3D0" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="BrandTileStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,8,8,0" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushNeutral}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="IconPlateStyle" TargetType="Border">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="#ECFEFF" />
            <Setter Property="BorderBrush" Value="#99F6E4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="HelpTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushNeutral}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushNeutral}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="ListView">
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushNeutral}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Background" Value="#E5E7EB" />
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="MaxWidth" Value="360" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Background" Value="#111827" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#374151" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HasDropShadow" Value="True" />
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushNeutral}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}" />
            <Setter Property="Background" Value="{StaticResource ErrorBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Window.Resources>

    <Grid Margin="18" Background="{StaticResource AppBackgroundBrush}">
        <Grid x:Name="ContentGrid" KeyboardNavigation.TabNavigation="Cycle">
            <Grid.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="HeaderCard" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18" />
                            <DoubleAnimation Storyboard.TargetName="WizardCard" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22" BeginTime="0:0:0.05" />
                            <DoubleAnimation Storyboard.TargetName="FooterCard" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18" BeginTime="0:0:0.10" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Grid.Triggers>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="HeaderCard" Style="{StaticResource StepCardStyle}" Padding="14" Margin="0,0,0,12" Opacity="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="InstallerLogoFrame" Width="76" Height="76" CornerRadius="8" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrushNeutral}" BorderThickness="1" Padding="7" Margin="0,0,16,0" ToolTip="Identidad EvaluaPro del instalador.">
                        <Image x:Name="InstallerLogoImage" Source="pack://application:,,,/assets/evaluapro-installer-logo.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Logo EvaluaPro Installer Hub" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="EvaluaPro Installer Hub" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                        <TextBlock x:Name="BrandStatementTextBlock" Margin="0,2,0,0" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Text="Asistente guiado para instalar, reparar, actualizar y desinstalar con evidencia operativa." TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource StatusBadgeStyle}">
                            <TextBlock x:Name="HubVersionTextBlock" Text="v-" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                        </Border>
                        <Border Style="{StaticResource StatusBadgeStyle}" Visibility="Collapsed">
                            <TextBlock x:Name="BrandVersionBadgeTextBlock" Text="Burn + MSI + helper" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="WizardCard" Grid.Row="1" Style="{StaticResource StepCardStyle}" Opacity="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel x:Name="StepperHost" Orientation="Horizontal" Margin="0,0,0,14" AutomationProperties.Name="Progreso del asistente">
                        <Border x:Name="TermsStepBorder" Style="{StaticResource StatusBadgeStyle}" MinWidth="118">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path x:Name="TermsStepIcon" Width="14" Height="14" Margin="0,0,6,0" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" SnapsToDevicePixels="True" />
                                <TextBlock x:Name="TermsStepTextBlock" Text="1 Términos · activo" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Rectangle x:Name="StepConnectorTermsPrepare" Width="16" Height="2" Fill="#D9E2EA" VerticalAlignment="Center" Margin="-4,0,4,0" RadiusX="1" RadiusY="1" />
                        <Border x:Name="PrepareStepBorder" Style="{StaticResource StatusBadgeStyle}" MinWidth="118" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrushNeutral}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path x:Name="PrepareStepIcon" Width="14" Height="14" Margin="0,0,6,0" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" SnapsToDevicePixels="True" />
                                <TextBlock x:Name="PrepareStepTextBlock" Text="2 Preparar · pendiente" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Rectangle x:Name="StepConnectorPrepareReview" Width="16" Height="2" Fill="#D9E2EA" VerticalAlignment="Center" Margin="-4,0,4,0" RadiusX="1" RadiusY="1" />
                        <Border x:Name="ReviewStepBorder" Style="{StaticResource StatusBadgeStyle}" MinWidth="118" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrushNeutral}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path x:Name="ReviewStepIcon" Width="14" Height="14" Margin="0,0,6,0" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" SnapsToDevicePixels="True" />
                                <TextBlock x:Name="ReviewStepTextBlock" Text="3 Revisar · pendiente" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Rectangle x:Name="StepConnectorReviewExecute" Width="16" Height="2" Fill="#D9E2EA" VerticalAlignment="Center" Margin="-4,0,4,0" RadiusX="1" RadiusY="1" />
                        <Border x:Name="ExecuteStepBorder" Style="{StaticResource StatusBadgeStyle}" MinWidth="118" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrushNeutral}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path x:Name="ExecuteStepIcon" Width="14" Height="14" Margin="0,0,6,0" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" SnapsToDevicePixels="True" />
                                <TextBlock x:Name="ExecuteStepTextBlock" Text="4 Ejecutar · pendiente" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Rectangle x:Name="StepConnectorExecuteResult" Width="16" Height="2" Fill="#D9E2EA" VerticalAlignment="Center" Margin="-4,0,4,0" RadiusX="1" RadiusY="1" />
                        <Border x:Name="ResultStepBorder" Style="{StaticResource StatusBadgeStyle}" MinWidth="118" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrushNeutral}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path x:Name="ResultStepIcon" Width="14" Height="14" Margin="0,0,6,0" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" SnapsToDevicePixels="True" />
                                <TextBlock x:Name="ResultStepTextBlock" Text="5 Resultado · pendiente" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border x:Name="StatusCardBorder" Grid.Row="1" Padding="12" CornerRadius="8" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" Margin="0,0,0,82">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="StatusVisualPlate" Style="{StaticResource IconPlateStyle}" ToolTip="Indicador visual del estado general de la operación.">
                                <Path x:Name="StatusVisualIcon" Data="M6,22 L15,31 L34,12" Stroke="{StaticResource PrimaryBrush}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Margin="10" />
                            </Border>
                            <!-- Animated Circular Vector Process Spinner -->
                            <Grid x:Name="StatusSpinner" Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center" Width="20" Height="20" Visibility="Collapsed">
                                <Ellipse Stroke="#E5E7EB" StrokeThickness="2.5" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Path Stroke="{Binding ElementName=StatusBadgeTextBlock, Path=Foreground}" StrokeThickness="2.5" StrokeStartLineCap="Round" Width="20" Height="20" Data="M10,1.25 A8.75,8.75 0 0 1 18.75,10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path.RenderTransform>
                                        <RotateTransform x:Name="SpinnerTransform" CenterX="10" CenterY="10" />
                                    </Path.RenderTransform>
                                    <Path.Triggers>
                                        <EventTrigger RoutedEvent="Path.Loaded">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="SpinnerTransform" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:1.2" RepeatBehavior="Forever" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Path.Triggers>
                                </Path>
                            </Grid>
                            <TextBlock x:Name="StatusBadgeTextBlock" Grid.Column="2" Text="Estado activo" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="3">
                                <TextBlock x:Name="StatusTextBlock" Text="Analizando prerequisitos..." Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="StatusHintTextBlock" Text="La operación todavía no termina." Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="LiveExplanationBorder" Grid.Row="1" Margin="0,74,0,14" Padding="10" CornerRadius="8" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrushNeutral}" BorderThickness="1" ToolTip="Explica qué está pasando y qué espera el asistente en este momento.">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path x:Name="LiveExplanationIcon" Width="18" Height="18" Data="M9,2 A7,7 0 1 1 8.99,2 M9,6 L9,10 M9,13 L9,13.5" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="LiveExplanationTitleTextBlock" Text="Qué está pasando" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                                <TextBlock x:Name="LiveExplanationTextBlock" Text="El asistente está esperando que completes el paso visible antes de continuar." FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid x:Name="StepHost" Grid.Row="2">
                        <!-- Pantalla Independiente de Términos y Condiciones -->
                        <Grid x:Name="TermsStepPanel" Visibility="Visible">
                            <Border Style="{StaticResource PanelCardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Términos y condiciones de licencia y privacidad" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Grid.Row="1" Style="{StaticResource HelpTextStyle}" Margin="0,4,0,12" Text="Debes leer y aceptar los términos y condiciones antes de instalar o configurar el software." />
                                    
                                    <Border Grid.Row="2" BorderThickness="1" BorderBrush="{StaticResource BorderBrushNeutral}" CornerRadius="4" Background="White" Padding="12">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <TextBlock x:Name="TermsText" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource MutedTextBrush}" LineHeight="18" xml:space="preserve">
TÉRMINOS Y CONDICIONES DE LICENCIA Y PRIVACIDAD

Por favor, lee atentamente los siguientes términos antes de proceder con la instalación de EvaluaPro. Al continuar, aceptas estar sujeto a estas condiciones:

1. MODELO DE LICENCIA DUAL
- Edición Comunitaria: Distribuida gratuitamente bajo la licencia de código abierto AGPLv3 (GNU Affero General Public License). Cualquier modificación o distribución del núcleo debe respetar los términos copyleft correspondientes.
- Edición Comercial / Institucional: Habilitada mediante una licencia propietaria de pago, la cual exime al usuario de las restricciones copyleft para despliegues privados y otorga acceso a capacidades adicionales, actualizaciones y soporte técnico SLA específico.

2. SUSCRIPCIÓN DE PRUEBA Y DATOS OPERATIVOS
- Al utilizar la promoción de prueba comercial de 35 días, aceptas que EvaluaPro recopile y procese datos de uso técnico y métricas operativas con fines de soporte, mejora del producto y conversión comercial.
- Todos los datos procesados respetan el Aviso de Privacidad y cumplen con los derechos ARCO/DSR aplicables.

3. RESTRICCIONES DE USO
- Queda expresamente prohibida la redistribución, modificación o ingeniería inversa de los componentes propietarios sin la previa autorización por escrito del titular del copyright.
- No está permitido remover ni alterar los avisos de autoría, derechos de propiedad intelectual o firmas de trazabilidad del sistema.

4. SOPORTE Y CONTACTO
- Para cualquier aclaración, activación de licencias o temas de privacidad, puedes contactar al DPO en: armsystechno@gmail.com
</TextBlock>
                                        </ScrollViewer>
                                    </Border>
                                    
                                    <CheckBox x:Name="AcceptTermsCheckBox" Grid.Row="3" Content="Acepto los términos y condiciones de licencia, uso y privacidad de EvaluaPro." IsChecked="False" Margin="0,14,0,0" FontSize="13" FontWeight="SemiBold" ToolTip="Debe marcar esta casilla para poder avanzar." Click="AcceptTermsCheckBox_OnClick" TabIndex="5" />
                                </Grid>
                            </Border>
                        </Grid>

                        <ScrollViewer x:Name="PrepareStepPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid>
                            <Border Style="{StaticResource PanelCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Preparar operación" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Style="{StaticResource HelpTextStyle}" Text="Confirma edición, modo, carpeta destino y accesos antes de revisar el equipo." />
                                    <Border x:Name="ModeImpactBorder" Margin="0,14,0,0" Padding="12" CornerRadius="8" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" ToolTip="Resumen práctico del impacto del modo seleccionado antes de ejecutar cambios en este equipo.">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="ModeImpactIconPlate" Style="{StaticResource IconPlateStyle}">
                                                <Path x:Name="ModeImpactIcon" Data="M6,22 L15,31 L34,12" Stroke="{StaticResource AccentBrush}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Margin="10" />
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock x:Name="ModeImpactTitleTextBlock" Text="Instalar o actualizar" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                                <TextBlock x:Name="ModeImpactTextBlock" Margin="0,6,0,0" Text="Configura prerequisitos, escribe configuración operativa y crea accesos." TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" />
                                                <TextBlock x:Name="ModeImpactChecklistTextBlock" Margin="0,6,0,0" Text="Se revisa WSL2/Docker/Node, carpeta destino y accesos." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel x:Name="FlavorPanel" Margin="0,0,10,0">
                                            <TextBlock Text="Edición" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBlock Text="Perfil funcional del paquete." Style="{StaticResource HelpTextStyle}" />
                                            <ComboBox x:Name="FlavorComboBox" Margin="0,8,0,0" SelectionChanged="FlavorComboBox_OnSelectionChanged" AutomationProperties.Name="Edición del instalador" AutomationProperties.HelpText="Selecciona el flavor de EvaluaPro que se instalará o mantendrá en este equipo." TabIndex="0">
                                                <ComboBox.ToolTip>
                                                    <ToolTip>
                                                        <StackPanel>
                                                            <TextBlock Text="Edición del instalador" FontWeight="SemiBold" />
                                                            <TextBlock Text="docente-local es el perfil recomendado para aportar desde el primer día en un equipo docente." TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </ToolTip>
                                                </ComboBox.ToolTip>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel x:Name="ModePanel" Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock Text="Modo" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBlock Text="Instalar, reparar o desinstalar." Style="{StaticResource HelpTextStyle}" />
                                            <ComboBox x:Name="ModeComboBox" Margin="0,8,0,0" SelectionChanged="ModeComboBox_OnSelectionChanged" AutomationProperties.Name="Modo de operación" AutomationProperties.HelpText="Instalar o actualizar, reparar la instalación existente, o desinstalar EvaluaPro." TabIndex="1">
                                                <ComboBox.ToolTip>
                                                    <ToolTip>
                                                        <StackPanel>
                                                            <TextBlock Text="Modo de operación" FontWeight="SemiBold" />
                                                            <TextBlock Text="Cambia la intención del asistente. La tarjeta azul resume qué hará cada modo antes de revisar prerequisitos." TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </ToolTip>
                                                </ComboBox.ToolTip>
                                                <ComboBoxItem Tag="install" Content="Instalar" />
                                                <ComboBoxItem Tag="repair" Content="Reparar" />
                                                <ComboBoxItem Tag="uninstall" Content="Desinstalar" />
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                    <Border Style="{StaticResource StepCardStyle}" Padding="12" Margin="0,16,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Ruta de instalación" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBlock Text="Carpeta destino usada por instalación, reparación o desinstalación." Style="{StaticResource HelpTextStyle}" />
                                            <TextBox x:Name="InstallDirTextBox" Margin="0,8,0,0" AutomationProperties.Name="Ruta de instalación" AutomationProperties.HelpText="Carpeta destino donde se instalará EvaluaPro." TabIndex="2">
                                                <TextBox.ToolTip>
                                                    <ToolTip>
                                                        <StackPanel>
                                                            <TextBlock Text="Ruta de instalación" FontWeight="SemiBold" />
                                                            <TextBlock Text="Usa una carpeta local estable. En reparación se reutiliza para ubicar configuración y accesos existentes." TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </ToolTip>
                                                </TextBox.ToolTip>
                                            </TextBox>
                                            <WrapPanel Margin="0,12,0,0">
                                                <CheckBox x:Name="DesktopShortcutsCheckBox" Content="Accesos en escritorio" IsChecked="True" Margin="0,0,18,8" ToolTip="Crea accesos directos en el escritorio." AutomationProperties.Name="Crear accesos en escritorio" TabIndex="3" />
                                                <CheckBox x:Name="StartMenuShortcutsCheckBox" Content="Accesos en menú Inicio" IsChecked="True" Margin="0,0,18,8" ToolTip="Crea accesos directos en el menú Inicio." AutomationProperties.Name="Crear accesos en menú Inicio" TabIndex="4" />
                                                <CheckBox x:Name="ExportDataCheckBox" Content="Respaldar mis datos localmente antes de desinstalar" IsChecked="False" Margin="0,0,18,8" ToolTip="Copia la base de datos a Documentos Públicos antes de borrar la instalación." Visibility="Collapsed" AutomationProperties.Name="Respaldar datos" TabIndex="5" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            </Grid>
                        </ScrollViewer>

                        <ScrollViewer x:Name="ReviewStepPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.35*" />
                                    <ColumnDefinition Width="0.65*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="Revisar prerequisitos" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Style="{StaticResource HelpTextStyle}" Text="Valida requisitos antes de ejecutar la operación seleccionada." />
                                    <TextBlock x:Name="DetectionSummaryTextBlock" Margin="0,12,0,10" TextWrapping="Wrap" ToolTip="Resumen automático del diagnóstico del equipo." />
                                    <Border x:Name="PrereqSummaryBorder" Margin="0,0,0,10" Padding="12" CornerRadius="8" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrushNeutral}" BorderThickness="1" ToolTip="Conteo rápido para decidir si puedes continuar o debes corregir prerequisitos.">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="PrereqSummaryIconPlate" Style="{StaticResource IconPlateStyle}">
                                                <Path x:Name="PrereqSummaryIcon" Data="M8,24 L17,32 L34,12" Stroke="{StaticResource MutedTextBrush}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Margin="10" />
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock x:Name="PrereqSummaryTextBlock" Text="Sin diagnóstico reciente" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                                                <TextBlock x:Name="PrereqSummaryHintTextBlock" Margin="0,5,0,0" Text="Pulsa Revisar equipo para actualizar el estado." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <ListView x:Name="PrereqListView" MinHeight="72" MaxHeight="96" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Resultado de prerequisitos" AutomationProperties.HelpText="Lista de requisitos detectados con versión y motivo." TabIndex="5">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="ToolTip" Value="{Binding ToolTipText}" />
                                                <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleSummary}" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="Prerequisito" Width="175" DisplayMemberBinding="{Binding Name}" />
                                                <GridViewColumn Header="Estado" Width="110">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border CornerRadius="4" Padding="6,3" BorderThickness="1" SnapsToDevicePixels="True" HorizontalAlignment="Left">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding InstalledLabel}" Value="OK">
                                                                                <Setter Property="Background" Value="#ECFDF5" />
                                                                                <Setter Property="BorderBrush" Value="#A7F3D0" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding InstalledLabel}" Value="FALTA">
                                                                                <Setter Property="Background" Value="#FEF2F2" />
                                                                                <Setter Property="BorderBrush" Value="#FECACA" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                    <Path Width="10" Height="10" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,4,0" VerticalAlignment="Center">
                                                                        <Path.Style>
                                                                            <Style TargetType="Path">
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding InstalledLabel}" Value="OK">
                                                                                        <Setter Property="Data" Value="M1,5.5 L4,8.5 L9,2.5" />
                                                                                        <Setter Property="Stroke" Value="#15803D" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding InstalledLabel}" Value="FALTA">
                                                                                        <Setter Property="Data" Value="M1,1 L9,9 M9,1 L1,9" />
                                                                                        <Setter Property="Stroke" Value="#B42318" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Path.Style>
                                                                    </Path>
                                                                    <TextBlock Text="{Binding InstalledLabel}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding InstalledLabel}" Value="OK">
                                                                                        <Setter Property="Foreground" Value="#15803D" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding InstalledLabel}" Value="FALTA">
                                                                                        <Setter Property="Foreground" Value="#B42318" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="Versión" Width="96" DisplayMemberBinding="{Binding ActualVersion}" />
                                                <GridViewColumn Header="Detalle" Width="330">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="58" />
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </StackPanel>
                            </Border>
                                <Border Style="{StaticResource PanelCardStyle}" Grid.Column="1">
                                <StackPanel>
                                    <TextBlock Text="Decisión" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Style="{StaticResource HelpTextStyle}" Text="Si todo está listo, ejecuta la acción primaria. Si algo falta, revisa evidencia y vuelve a detectar." />
                                    <Border x:Name="StageSummaryBorder" Margin="0,16,0,0" Padding="12" CornerRadius="8" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock x:Name="StageSummaryBadgeTextBlock" Text="En curso" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                            <TextBlock x:Name="StageSummaryTitleTextBlock" Margin="0,6,0,0" Text="Etapa actual: detección" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                                            <TextBlock x:Name="StageSummaryTextBlock" Margin="0,6,0,0" Text="El asistente está preparando la validación inicial." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                </Border>
                            </Grid>
                        </ScrollViewer>

                        <Grid x:Name="ExecuteStepPanel" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.92*" />
                                <ColumnDefinition Width="1.08*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock x:Name="WorkflowHeaderTitleTextBlock" Text="Ejecutar operación" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                    <TextBlock x:Name="WorkflowHeaderHintTextBlock" Style="{StaticResource HelpTextStyle}" Text="Resumen en vivo de la operación seleccionada." />
                                    <ProgressBar x:Name="InstallProgressBar" Margin="0,18,0,12" Minimum="0" Maximum="100" ToolTip="Progreso general de la operación." AutomationProperties.Name="Progreso general de la operación" />
                                    <Border x:Name="FailureSummaryBorder" Margin="0,0,0,10" Padding="12" CornerRadius="8" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" Visibility="Collapsed">
                                        <StackPanel>
                                            <TextBlock x:Name="FailureSummaryTitleTextBlock" Text="Resumen de error" FontWeight="Bold" Foreground="{StaticResource ErrorBrush}" />
                                            <TextBlock x:Name="FailureSummaryTextBlock" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource ErrorBrush}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PanelCardStyle}" Grid.Column="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Línea de tareas" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Text="Etapas completadas, activas o fallidas." Style="{StaticResource HelpTextStyle}" />
                                    </StackPanel>
                                    <ScrollViewer x:Name="StageTimelineScrollViewer" Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                                        <StackPanel x:Name="StageTimelineHost" />
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid x:Name="ResultStepPanel" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.9*" />
                                <ColumnDefinition Width="1.1*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="Resultado" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Text="Estado final, acción recomendada y evidencia para soporte." Style="{StaticResource HelpTextStyle}" />
                                    <Border Margin="0,16,0,0" Padding="14" CornerRadius="8" Background="#ECFDF5" BorderBrush="#BBF7D0" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="{Binding ElementName=StatusBadgeTextBlock, Path=Text}" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" />
                                            <TextBlock Text="{Binding ElementName=StatusTextBlock, Path=Text}" Margin="0,6,0,0" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding ElementName=StatusHintTextBlock, Path=Text}" Margin="0,6,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PanelCardStyle}" Grid.Column="1">
                                <StackPanel>
                                    <TextBlock Text="Evidencia técnica" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Text="Rutas y resumen para soporte cuando la operación termina." Style="{StaticResource HelpTextStyle}" />
                                    <Border Margin="0,14,0,0" Padding="12" CornerRadius="8" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrushNeutral}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="Bitácora de sesión" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                            <TextBox Margin="0,6,0,0"
                                                     Text="%ProgramData%\EvaluaPro\installer-hub\logs"
                                                     IsReadOnly="True"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     Foreground="{StaticResource MutedTextBrush}"
                                                     AutomationProperties.Name="Ruta de bitácoras técnicas" />
                                            <TextBlock Margin="0,8,0,0"
                                                       Text="El panel inferior conserva la salida de esta sesión; en error se abre automáticamente."
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <Expander x:Name="LogExpander" Grid.Row="3" Header="Bitácora técnica" IsExpanded="False" Margin="0,14,0,0" ToolTip="Detalle técnico para soporte.">
                        <TextBox x:Name="LogTextBox"
                                 Height="116"
                                 FontFamily="Consolas"
                                 IsReadOnly="True"
                                 TextWrapping="NoWrap"
                                 AcceptsReturn="True"
                                 HorizontalScrollBarVisibility="Auto"
                                 VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="Bitácora técnica de instalación"
                                 AutomationProperties.HelpText="Salida técnica de la sesión para soporte."
                                 ToolTip="Bitácora detallada de la sesión." />
                    </Expander>
                </Grid>
            </Border>

            <Border x:Name="FooterCard" Grid.Row="2" Style="{StaticResource StepCardStyle}" Padding="12" Margin="0,12,0,0" Opacity="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock x:Name="FooterStatusTextBlock" Text="Listo para guiar la operación." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                        <TextBlock x:Name="FooterNextActionTextBlock" Text="Acepta términos para continuar." Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="DetectButton" Content="_Revisar equipo" Style="{StaticResource SecondaryButtonStyle}" MinWidth="130" Margin="0,0,8,0" Click="DetectButton_OnClick" ToolTip="Ejecuta nuevamente la revisión de prerequisitos." AutomationProperties.Name="Revisar equipo" AutomationProperties.HelpText="Ejecuta el diagnóstico de prerequisitos de Windows, WSL, Docker y Node." TabIndex="20" />
                        <Button x:Name="BackButton" Content="_Atrás" Style="{StaticResource SecondaryButtonStyle}" MinWidth="90" Margin="0,0,8,0" Click="BackButton_OnClick" ToolTip="Vuelve al paso anterior." AutomationProperties.Name="Atrás" AutomationProperties.HelpText="Vuelve al paso anterior del asistente." TabIndex="21" />
                        <Button x:Name="NextButton" Content="_Siguiente" Style="{StaticResource SecondaryButtonStyle}" MinWidth="110" Margin="0,0,8,0" Click="NextButton_OnClick" ToolTip="Avanza al siguiente paso." AutomationProperties.Name="Siguiente" AutomationProperties.HelpText="Avanza al siguiente paso del asistente." TabIndex="22" />
                        <Button x:Name="StartButton" Content="_Continuar" Style="{StaticResource PrimaryButtonStyle}" MinWidth="130" Margin="0,0,8,0" Click="StartButton_OnClick" ToolTip="Inicia la operación seleccionada." AutomationProperties.Name="Iniciar operación seleccionada" AutomationProperties.HelpText="Instala, repara o desinstala EvaluaPro según el modo elegido." TabIndex="23" />
                        <Button x:Name="RestartNowButton" Content="Reiniciar _ahora" Style="{StaticResource DangerButtonStyle}" MinWidth="140" Margin="0,0,8,0" Visibility="Collapsed" Click="RestartNowButton_OnClick" ToolTip="Reinicia Windows para retomar automáticamente la instalación." AutomationProperties.Name="Reiniciar ahora" AutomationProperties.HelpText="Reinicia Windows y registra la reanudación automática del Hub." TabIndex="24" />
                        <Button x:Name="CloseButton" Content="_Cerrar" Style="{StaticResource SecondaryButtonStyle}" Width="100" Click="CloseButton_OnClick" ToolTip="Cierra el asistente." AutomationProperties.Name="Cerrar Installer Hub" AutomationProperties.HelpText="Cierra la ventana si no hay una operación en progreso." TabIndex="25" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="SplashOverlay" Grid.RowSpan="3" Panel.ZIndex="99" Background="#CC111827" Visibility="Collapsed">
                <Border Width="560" Height="310" CornerRadius="8" Background="#0F766E" BorderBrush="#5EEAD4" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="138" Height="138" CornerRadius="8" Background="#ECFEFF" BorderBrush="#99F6E4" BorderThickness="1" Padding="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid>
                                <Border CornerRadius="8" Background="White" BorderBrush="#CCFBF1" BorderThickness="1" Padding="8">
                                    <Image x:Name="SplashInstallerLogoImage" Source="pack://application:,,,/assets/evaluapro-installer-logo.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Logo EvaluaPro Installer Hub en inicio" />
                                </Border>
                                <Border Width="34" Height="34" CornerRadius="8" Background="#2563EB" BorderBrush="White" BorderThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-6,-6">
                                    <Path Data="M6,17 L14,24 L28,9" Stroke="White" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Margin="6" />
                                </Border>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0,0,0">
                            <TextBlock Text="EvaluaPro Installer Hub" Foreground="White" FontSize="28" FontWeight="SemiBold" />
                            <TextBlock Text="Inicializando asistente guiado..." Foreground="#CCFBF1" Margin="0,8,0,0" FontSize="14" />
                            <UniformGrid x:Name="SplashGraphicIndicators" Columns="3" Margin="0,22,0,0">
                                <Border CornerRadius="8" Background="#134E4A" BorderBrush="#5EEAD4" BorderThickness="1" Padding="10" Margin="0,0,8,0">
                                    <StackPanel>
                                        <Path Width="22" Height="22" Data="M4,6 L18,6 M4,11 L18,11 M4,16 L13,16" Stroke="#99F6E4" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Left" />
                                        <TextBlock Text="Preparar" Foreground="White" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border CornerRadius="8" Background="#134E4A" BorderBrush="#5EEAD4" BorderThickness="1" Padding="10" Margin="0,0,8,0">
                                    <StackPanel>
                                        <Path Width="22" Height="22" Data="M4,12 L9,17 L18,6" Stroke="#99F6E4" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Left" />
                                        <TextBlock Text="Validar" Foreground="White" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border CornerRadius="8" Background="#134E4A" BorderBrush="#5EEAD4" BorderThickness="1" Padding="10">
                                    <StackPanel>
                                        <Path Width="22" Height="22" Data="M5,5 L17,5 L17,17 L5,17 Z M8,12 L10,14 L14,9" Stroke="#99F6E4" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Left" />
                                        <TextBlock Text="Ejecutar" Foreground="White" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
