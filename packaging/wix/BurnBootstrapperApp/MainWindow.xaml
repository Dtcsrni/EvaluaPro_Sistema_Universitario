                                                            <ComboBoxItem Tag="repair" Content="Reparar componentes" />
                                                            <ComboBoxItem Tag="uninstall" Content="Desinstalar (con respaldo)" />
                                                        </ComboBox>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>

                                            <!-- Columna 2: Ruta de instalación + Accesos directos -->
                                            <Border Grid.Column="2" Style="{StaticResource StepCardStyle}" Padding="12,10" Margin="0,0,0,0" VerticalAlignment="Stretch">
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Ruta de instalación" Style="{StaticResource FieldLabelStyle}" FontSize="13" FontWeight="Bold" />
                                                    <TextBlock Text="Carpeta destino usada por la instalación." Style="{StaticResource HelpTextStyle}" FontSize="11.5" />
                                                    <TextBox x:Name="InstallDirTextBox" Margin="0,4,0,0" AutomationProperties.Name="Ruta de instalación" AutomationProperties.HelpText="Carpeta destino donde se instalará EvaluaPro. Mantén el puntero para consultar la ruta completa." TabIndex="2" FontSize="12.5" ToolTipService.ShowDuration="30000">
                                                        <TextBox.ToolTip>
                                                            <ToolTip>
                                                                <StackPanel>
                                                                    <TextBlock Text="Ruta de instalación" FontWeight="SemiBold" />
                                                                    <TextBlock Text="{Binding PlacementTarget.Text, RelativeSource={RelativeSource AncestorType=ToolTip}}" TextWrapping="Wrap" Margin="0,2,0,4" />
