                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Path Data="M13,1 L5,12 H11 L10,23 L19,9 H13 Z" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{StaticResource AccentBrush}" Focusable="False" IsHitTestVisible="False" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="Procesador &amp; Memoria RAM" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
