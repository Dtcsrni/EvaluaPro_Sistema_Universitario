                                                        <ComboBox x:Name="FlavorComboBox" Margin="0,4,0,0" SelectionChanged="FlavorComboBox_OnSelectionChanged" AutomationProperties.Name="Edición del instalador" AutomationProperties.HelpText="Selecciona el flavor de EvaluaPro que se instalará o mantendrá en este equipo." TabIndex="0">
                                                            <ComboBox.ToolTip>
                                                                <ToolTip>
                                                                    <StackPanel>
                                                                        <TextBlock Text="Edición del instalador" FontWeight="SemiBold" />
                                                                        <TextBlock Text="docente-local es el perfil recomendado para aportar desde el primer día en un equipo docente." TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                </ToolTip>
                                                            </ComboBox.ToolTip>
                                                        </ComboBox>
                                                    </StackPanel>
                                                    <StackPanel x:Name="ModePanel" Grid.Column="2">
                                                        <TextBlock Text="Modo" Style="{StaticResource FieldLabelStyle}" FontSize="13" FontWeight="Bold" />
                                                        <TextBlock Text="Instalar, reparar o desinstalar." Style="{StaticResource HelpTextStyle}" FontSize="11.5" />
                                                        <ComboBox x:Name="ModeComboBox" Margin="0,4,0,0" SelectionChanged="ModeComboBox_OnSelectionChanged" AutomationProperties.Name="Modo de operación" AutomationProperties.HelpText="Instalar o actualizar, reparar la instalación existente, o desinstalar EvaluaPro." TabIndex="1">
                                                            <ComboBox.ToolTip>
                                                                <ToolTip>
                                                                    <StackPanel>
                                                                        <TextBlock Text="Modo de operación" FontWeight="SemiBold" />
