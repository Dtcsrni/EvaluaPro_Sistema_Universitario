<!--
  MainWindow.xaml
  Wizard visual del Installer Hub con pasos operativos, UI moderna y trazabilidad por estado.
-->
<Window x:Class="EvaluaPro.BurnBootstrapperApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="EvaluaPro Installer Hub"
        Icon="pack://application:,,,/assets/evaluapro-installer-logo.png"
        Width="1440"
        Height="900"
        MinWidth="1180"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#B51E3A5F"
        FontFamily="Segoe UI Variable Text, Segoe UI, Aptos"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        AutomationProperties.Name="EvaluaPro Installer Hub">
    <Window.Resources>
        <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F108162B" Offset="0" />
            <GradientStop Color="#E00B4F5C" Offset="0.52" />
            <GradientStop Color="#F11B2A5A" Offset="1" />
        </LinearGradientBrush>
        <!-- Vidrio compuesto: brillo superior, tinte cromático y fondo DWM. -->
        <LinearGradientBrush x:Key="SurfaceBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#D91B314B" Offset="0" />
            <GradientStop Color="#B80E263D" Offset="0.48" />
            <GradientStop Color="#C9143B51" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SubtleSurfaceBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#B81D3A50" Offset="0" />
            <GradientStop Color="#88214B5D" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="BorderBrushNeutral" Color="#80B8F3F5" />
        <SolidColorBrush x:Key="TextBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#C4D5E8" />
        <SolidColorBrush x:Key="TermsTextBrush" Color="#17324D" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#14B8A6" />
        <SolidColorBrush x:Key="AccentBrush" Color="#38BDF8" />
        <!-- Tono semántico conservado para estados de éxito calculados en code-behind. -->
        <SolidColorBrush x:Key="SuccessTealBrush" Color="#0F766E" />
        <SolidColorBrush x:Key="WarningBrush" Color="#B45309" />
        <SolidColorBrush x:Key="ErrorBrush" Color="#B42318" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#15803D" />
        <SolidColorBrush x:Key="FocusBrush" Color="#7DD3FC" />
        <SolidColorBrush x:Key="GlassHighlightBrush" Color="#66E0F2FE" />
        <DropShadowEffect x:Key="CardShadow" BlurRadius="28" ShadowDepth="7" Direction="270" Opacity="0.28" Color="#102A43" />
        <LinearGradientBrush x:Key="SecondaryButtonBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#D9385268" Offset="0" />
            <GradientStop Color="#A81A3045" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PrimaryButtonBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2DE0C9" Offset="0" />
            <GradientStop Color="#079A8C" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="StepCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushNeutral}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Effect" Value="{StaticResource CardShadow}" />
        </Style>

        <Style x:Key="PanelCardStyle" TargetType="Border" BasedOn="{StaticResource StepCardStyle}">
            <Setter Property="Padding" Value="14" />
            <Setter Property="Background" Value="{StaticResource SubtleSurfaceBrush}" />
        </Style>

        <Style x:Key="StatusBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="#CC0B2A3C" />
            <Setter Property="BorderBrush" Value="#8038DDF5" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="BrandTileStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,8,8,0" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushNeutral}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="IconPlateStyle" TargetType="Border">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="#D91B4961" />
            <Setter Property="BorderBrush" Value="#B238DDF5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="HelpTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushNeutral}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#EFF8FAFC" />
            <Setter Property="Foreground" Value="#0F172A" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushNeutral}" />
            <Setter Property="Foreground" Value="#0F172A" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="ListView">
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushNeutral}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#EFF8FAFC" />
            <Setter Property="Foreground" Value="#0F172A" />
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Background" Value="#E5E7EB" />
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="MaxWidth" Value="360" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Background" Value="#111827" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#374151" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HasDropShadow" Value="True" />
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushNeutral}" />
            <Setter Property="Background" Value="{StaticResource SecondaryButtonBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E62DE0C9" />
                    <Setter Property="BorderBrush" Value="#B8F7FF" />
                    <Setter Property="Effect" Value="{StaticResource CardShadow}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.78" />
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderThickness" Value="2" />
                    <Setter Property="BorderBrush" Value="{StaticResource FocusBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="LineHeight" Value="20" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource PrimaryButtonBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}" />
            <Setter Property="Background" Value="{StaticResource ErrorBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Window.Resources>

    <Grid Margin="18" Background="{StaticResource AppBackgroundBrush}">
        <Grid x:Name="ContentGrid" KeyboardNavigation.TabNavigation="Cycle">
            <Grid.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="HeaderCard" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.32" />
                            <DoubleAnimation Storyboard.TargetName="WizardCard" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.42" BeginTime="0:0:0.08" />
                            <DoubleAnimation Storyboard.TargetName="FooterCard" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.32" BeginTime="0:0:0.16" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Grid.Triggers>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="HeaderCard" Style="{StaticResource StepCardStyle}" Padding="16" Margin="0,0,0,12" Opacity="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="InstallerLogoFrame" Width="82" Height="82" CornerRadius="14" Background="#D90B1D31" BorderBrush="#B838DDF5" BorderThickness="1" Padding="8" Margin="0,0,18,0" ToolTip="Identidad EvaluaPro del instalador.">
                        <Image x:Name="InstallerLogoImage" Source="pack://application:,,,/assets/evaluapro-installer-logo.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Logo EvaluaPro Installer Hub" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="EvaluaPro Installer Hub" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                        <TextBlock x:Name="BrandStatementTextBlock" Margin="0,3,0,0" FontSize="14" Foreground="{StaticResource MutedTextBrush}" Text="Asistente guiado para instalar, reparar, actualizar y desinstalar con evidencia operativa." TextWrapping="Wrap" />
                        <Border Background="#CC0B2038" BorderBrush="#B338DDF5" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,10,0,0" MaxWidth="860" Effect="{StaticResource CardShadow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="HeaderFeatureTitleTextBlock" Text="Instala con confianza" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                                    <TextBlock x:Name="HeaderFeatureDescriptionTextBlock" Text="Revisa requisitos y conserva evidencia de cada etapa." FontSize="13" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" LineHeight="20" Margin="0,3,8,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="HeaderPreviousButton" Style="{StaticResource SecondaryButtonStyle}" Content="‹" Width="26" Height="24" Padding="0" Click="HeaderPreviousButton_OnClick" ToolTip="Función anterior" />
                                    <Button x:Name="HeaderNextButton" Style="{StaticResource SecondaryButtonStyle}" Content="›" Width="26" Height="24" Padding="0" Margin="4,0,0,0" Click="HeaderNextButton_OnClick" ToolTip="Siguiente función" />
                                    <TextBlock x:Name="HeaderFeatureIndexTextBlock" Text="1 de 3" FontSize="11" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                         <Button x:Name="ShowIntroButton" Content="Funciones" Style="{StaticResource SecondaryButtonStyle}" MinWidth="92" Margin="0,0,10,0" Visibility="Collapsed" Click="ShowIntroButton_OnClick" ToolTip="El carrusel de funciones permanece visible en el encabezado." AutomationProperties.Name="Mostrar funciones principales" />
                        <Border Style="{StaticResource StatusBadgeStyle}">
                            <TextBlock x:Name="HubVersionTextBlock" Text="v-" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                        </Border>
                        <Border Style="{StaticResource StatusBadgeStyle}" Visibility="Collapsed">
                            <TextBlock x:Name="BrandVersionBadgeTextBlock" Text="Burn + MSI + helper" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="WizardCard" Grid.Row="1" Style="{StaticResource StepCardStyle}" Opacity="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel x:Name="StepperHost" Orientation="Horizontal" Margin="0,0,0,14" AutomationProperties.Name="Progreso del asistente">
                        <Border x:Name="TermsStepBorder" Style="{StaticResource StatusBadgeStyle}" MinWidth="118">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path x:Name="TermsStepIcon" Width="14" Height="14" Margin="0,0,6,0" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" SnapsToDevicePixels="True" />
                                <TextBlock x:Name="TermsStepTextBlock" Text="1 Términos · activo" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Rectangle x:Name="StepConnectorTermsPrepare" Width="16" Height="2" Fill="#D9E2EA" VerticalAlignment="Center" Margin="-4,0,4,0" RadiusX="1" RadiusY="1" />
                        <Border x:Name="PrepareStepBorder" Style="{StaticResource StatusBadgeStyle}" MinWidth="118" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrushNeutral}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path x:Name="PrepareStepIcon" Width="14" Height="14" Margin="0,0,6,0" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" SnapsToDevicePixels="True" />
                                <TextBlock x:Name="PrepareStepTextBlock" Text="2 Preparar · pendiente" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Rectangle x:Name="StepConnectorPrepareReview" Width="16" Height="2" Fill="#D9E2EA" VerticalAlignment="Center" Margin="-4,0,4,0" RadiusX="1" RadiusY="1" />
                        <Border x:Name="ReviewStepBorder" Style="{StaticResource StatusBadgeStyle}" MinWidth="118" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrushNeutral}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path x:Name="ReviewStepIcon" Width="14" Height="14" Margin="0,0,6,0" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" SnapsToDevicePixels="True" />
                                <TextBlock x:Name="ReviewStepTextBlock" Text="3 Revisar · pendiente" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Rectangle x:Name="StepConnectorReviewExecute" Width="16" Height="2" Fill="#D9E2EA" VerticalAlignment="Center" Margin="-4,0,4,0" RadiusX="1" RadiusY="1" />
                        <Border x:Name="ExecuteStepBorder" Style="{StaticResource StatusBadgeStyle}" MinWidth="118" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrushNeutral}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path x:Name="ExecuteStepIcon" Width="14" Height="14" Margin="0,0,6,0" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" SnapsToDevicePixels="True" />
                                <TextBlock x:Name="ExecuteStepTextBlock" Text="4 Ejecutar · pendiente" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Rectangle x:Name="StepConnectorExecuteResult" Width="16" Height="2" Fill="#D9E2EA" VerticalAlignment="Center" Margin="-4,0,4,0" RadiusX="1" RadiusY="1" />
                        <Border x:Name="ResultStepBorder" Style="{StaticResource StatusBadgeStyle}" MinWidth="118" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrushNeutral}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path x:Name="ResultStepIcon" Width="14" Height="14" Margin="0,0,6,0" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" SnapsToDevicePixels="True" />
                                <TextBlock x:Name="ResultStepTextBlock" Text="5 Resultado · pendiente" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border x:Name="StatusCardBorder" Grid.Row="1" Padding="14" CornerRadius="12" Background="#D9144961" BorderBrush="#B838DDF5" BorderThickness="1" Margin="0" Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="StatusVisualPlate" Style="{StaticResource IconPlateStyle}" ToolTip="Indicador visual del estado general de la operación.">
                                <Path x:Name="StatusVisualIcon" Data="M6,22 L15,31 L34,12" Stroke="{StaticResource PrimaryBrush}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Margin="10" />
                            </Border>
                            <!-- Animated Circular Vector Process Spinner -->
                            <Grid x:Name="StatusSpinner" Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center" Width="20" Height="20" Visibility="Collapsed">
                                <Ellipse Stroke="#E5E7EB" StrokeThickness="2.5" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Path Stroke="{Binding ElementName=StatusBadgeTextBlock, Path=Foreground}" StrokeThickness="2.5" StrokeStartLineCap="Round" Width="20" Height="20" Data="M10,1.25 A8.75,8.75 0 0 1 18.75,10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path.RenderTransform>
                                        <RotateTransform x:Name="SpinnerTransform" CenterX="10" CenterY="10" />
                                    </Path.RenderTransform>
                                    <Path.Triggers>
                                        <EventTrigger RoutedEvent="Path.Loaded">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="SpinnerTransform" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:1.2" RepeatBehavior="Forever" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Path.Triggers>
                                </Path>
                            </Grid>
                            <TextBlock x:Name="StatusBadgeTextBlock" Grid.Column="2" Text="Estado activo" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="3">
                                <TextBlock x:Name="StatusTextBlock" Text="Analizando prerequisitos..." Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="StatusHintTextBlock" Text="La operación todavía no termina." Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="LiveExplanationBorder" Grid.Row="2" Margin="0,10,0,12" Padding="12" CornerRadius="10" Background="#B80B2038" BorderBrush="#8038DDF5" BorderThickness="1" ToolTip="Explica qué está pasando y qué espera el asistente en este momento.">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path x:Name="LiveExplanationIcon" Width="18" Height="18" Data="M9,2 A7,7 0 1 1 8.99,2 M9,6 L9,10 M9,13 L9,13.5" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="LiveExplanationTitleTextBlock" Text="Qué está pasando" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                                <TextBlock x:Name="LiveExplanationTextBlock" Text="El asistente está esperando que completes el paso visible antes de continuar." FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid x:Name="StepHost" Grid.Row="3">
                        <!-- Pantalla Independiente de Términos y Condiciones -->
                        <Grid x:Name="TermsStepPanel" Visibility="Visible">
                            <Border Style="{StaticResource PanelCardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Términos y condiciones de licencia y privacidad" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Grid.Row="1" Style="{StaticResource HelpTextStyle}" Margin="0,4,0,12" Text="Debes leer y aceptar los términos y condiciones antes de instalar o configurar el software." />
                                    
                                    <Border Grid.Row="2" BorderThickness="1" BorderBrush="{StaticResource BorderBrushNeutral}" CornerRadius="4" Background="White" Padding="12">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <TextBlock x:Name="TermsText" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource TermsTextBrush}" LineHeight="18" xml:space="preserve">
TÉRMINOS Y CONDICIONES DE LICENCIA Y PRIVACIDAD

Por favor, lee atentamente los siguientes términos antes de proceder con la instalación de EvaluaPro. Al continuar, aceptas estar sujeto a estas condiciones:

1. MODELO DE LICENCIA DUAL
- Edición Comunitaria: Distribuida gratuitamente bajo la licencia de código abierto AGPLv3 (GNU Affero General Public License). Cualquier modificación o distribución del núcleo debe respetar los términos copyleft correspondientes.
- Edición Comercial / Institucional: Habilitada mediante una licencia propietaria de pago, la cual exime al usuario de las restricciones copyleft para despliegues privados y otorga acceso a capacidades adicionales, actualizaciones y soporte técnico SLA específico.

2. SUSCRIPCIÓN DE PRUEBA Y DATOS OPERATIVOS
- Al utilizar la promoción de prueba comercial de 35 días, aceptas que EvaluaPro recopile y procese datos de uso técnico y métricas operativas con fines de soporte, mejora del producto y conversión comercial.
- Todos los datos procesados respetan el Aviso de Privacidad y cumplen con los derechos ARCO/DSR aplicables.

3. RESTRICCIONES DE USO
- Queda expresamente prohibida la redistribución, modificación o ingeniería inversa de los componentes propietarios sin la previa autorización por escrito del titular del copyright.
- No está permitido remover ni alterar los avisos de autoría, derechos de propiedad intelectual o firmas de trazabilidad del sistema.

4. SOPORTE Y CONTACTO
- Para cualquier aclaración, activación de licencias o temas de privacidad, puedes contactar al DPO en: armsystechno@gmail.com
</TextBlock>
                                        </ScrollViewer>
                                    </Border>
                                    
                                    <CheckBox x:Name="AcceptTermsCheckBox" Grid.Row="3" Content="Acepto los términos y condiciones de licencia y uso de EvaluaPro." IsChecked="False" Margin="0,14,0,0" FontSize="13" FontWeight="SemiBold" ToolTip="Debes aceptar la licencia para poder avanzar." Checked="AcceptTermsCheckBox_OnClick" Unchecked="AcceptTermsCheckBox_OnClick" TabIndex="5" />
