                                            <Border Background="#FF0F1B2D" BorderBrush="#FF526981" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,0,5">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Path Data="M3,4 H21 V17 H3 Z M8,21 H16 M12,17 V21" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Focusable="False" IsHitTestVisible="False" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="Sistema Operativo" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
