<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <AssemblyName>EvaluaPro.BurnBootstrapperApp</AssemblyName>
    <RootNamespace>EvaluaPro.BurnBootstrapperApp</RootNamespace>
    <ApplicationIcon>..\..\..\scripts\icons\installer-logo-contrast.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="EvaluaProAppVersion" Value="$(EvaluaProAppVersion)" />
    <EmbeddedResource Include="obj\classroom-oauth-defaults.json" LogicalName="EvaluaPro.BurnBootstrapperApp.classroom-oauth-defaults.json" Condition="Exists('obj\classroom-oauth-defaults.json')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.BootstrapperApplicationApi" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\..\scripts\icons\installer-canonical.ico" Link="installer-canonical.ico" />
    <Resource Include="..\..\..\logos\evaluapro-installer-logo-contrast.png" Link="assets/evaluapro-installer-logo.png" />
  </ItemGroup>

</Project>
