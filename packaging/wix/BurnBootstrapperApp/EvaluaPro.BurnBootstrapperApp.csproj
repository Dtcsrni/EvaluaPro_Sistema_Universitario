<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>1.1.1</Version>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <AssemblyName>EvaluaPro.BurnBootstrapperApp</AssemblyName>
    <RootNamespace>EvaluaPro.BurnBootstrapperApp</RootNamespace>
    <ApplicationIcon>..\..\..\scripts\icons\dashboard-hub-app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.BootstrapperApplicationApi" Version="6.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\..\scripts\icons\installer-canonical.ico" Link="installer-canonical.ico" />
    <Resource Include="..\..\..\logos\logo_sys.png" Link="assets/evaluapro-official-imagotipo.png" />
  </ItemGroup>

</Project>
