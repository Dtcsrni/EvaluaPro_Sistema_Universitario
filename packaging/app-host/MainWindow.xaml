<Window x:Class="EvaluaPro.AppHost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="EvaluaPro · Plataforma Docente"
        Height="820" Width="1280"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="#080e1a"
        Foreground="#f8fafc">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#080e1a" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#0f172a" />
        <SolidColorBrush x:Key="BorderBrush" Color="#1e293b" />
        <SolidColorBrush x:Key="PrimaryAccentBrush" Color="#0ea5e9" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#f8fafc" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#94a3b8" />

        <Style x:Key="WindowActionButtonStyle" TargetType="Button">
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#94a3b8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="34" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#1e293b" />
                                <Setter Property="Foreground" Value="#ffffff" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#334155" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowActionButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#e11d48" />
                                <Setter Property="Foreground" Value="#ffffff" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#be123c" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Dark Window Header -->
        <Border Grid.Row="0" Background="#0b1120" BorderBrush="#1e293b" BorderThickness="0,0,0,1" MouseDown="TitleBar_MouseDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand & Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Border Width="20" Height="20" CornerRadius="5" Background="#0284c7" Margin="0,0,9,0">
                        <TextBlock Text="🎓" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="EvaluaPro" FontWeight="SemiBold" FontSize="13" Foreground="#f8fafc" VerticalAlignment="Center" />
                    <TextBlock Text="· Plataforma Docente" FontSize="12" Foreground="#64748b" VerticalAlignment="Center" Margin="6,0,0,0" />
                </StackPanel>

                <!-- Status Text in Header -->
                <TextBlock x:Name="HeaderStatusTextBlock" Grid.Column="1" Text="" FontSize="11" Foreground="#0ea5e9"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />

                <!-- Window Action Buttons (Minimize, Maximize, Close) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource WindowActionButtonStyle}" Content="🗕" Click="MinimizeButton_Click" ToolTip="Minimizar" />
                    <Button x:Name="MaximizeBtn" Style="{StaticResource WindowActionButtonStyle}" Content="🗖" Click="MaximizeButton_Click" ToolTip="Maximizar" />
                    <Button Style="{StaticResource WindowCloseButtonStyle}" Content="✕" Click="CloseButton_Click" ToolTip="Cerrar" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <!-- Native Embedded WebView2 Browser Control -->
            <wpf:WebView2 x:Name="AppWebView" Visibility="Hidden" />

            <!-- Native WPF Loading Splash Screen -->
            <Grid x:Name="SplashOverlay" Background="#080e1a">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Glowing App Icon -->
                    <Border Width="84" Height="84" CornerRadius="22" Background="#0f172a" BorderBrush="#1e293b" BorderThickness="1.5"
                            HorizontalAlignment="Center" Margin="0,0,0,24">
                        <Border.Effect>
                            <DropShadowEffect Color="#0ea5e9" BlurRadius="32" Opacity="0.35" ShadowDepth="0" />
                        </Border.Effect>
                        <TextBlock Text="🎓" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <!-- Title & Tagline -->
                    <TextBlock Text="EvaluaPro" FontSize="26" FontWeight="Bold" Foreground="#f8fafc" HorizontalAlignment="Center" Margin="0,0,0,6" />
                    <TextBlock Text="Iniciando plataforma y servicios locales..." FontSize="14" Foreground="#94a3b8" HorizontalAlignment="Center" Margin="0,0,0,28" />

                    <!-- Native Loading Bar -->
                    <ProgressBar x:Name="SplashProgressBar" IsIndeterminate="True" Width="260" Height="4"
                                 Background="#1e293b" Foreground="#0ea5e9" BorderThickness="0" HorizontalAlignment="Center" Margin="0,0,0,14" />

                    <TextBlock x:Name="SplashStatusTextBlock" Text="Preparando entorno de datos y seguridad..."
                               FontSize="12" Foreground="#64748b" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- Error / Retry Overlay (if backend ever fails) -->
            <Grid x:Name="ErrorOverlay" Background="#080e1a" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480">
                    <TextBlock Text="⚠️" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,16" />
                    <TextBlock Text="No se pudo iniciar el servicio local" FontSize="20" FontWeight="Bold" Foreground="#f8fafc" HorizontalAlignment="Center" Margin="0,0,0,10" />
                    <TextBlock x:Name="ErrorMessageTextBlock" Text="Verifica que no haya otra instancia de EvaluaPro abierta."
                               TextWrapping="Wrap" FontSize="13" Foreground="#94a3b8" TextAlignment="Center" Margin="0,0,0,24" />
                    <Button Content="Reintentar inicio" Background="#0ea5e9" Foreground="#ffffff" FontWeight="SemiBold"
                            Padding="20,10" BorderThickness="0" Cursor="Hand" Click="RetryButton_Click" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
