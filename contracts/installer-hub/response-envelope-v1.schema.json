{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evaluapro.local/contracts/installer-hub/response-envelope-v1.schema.json",
  "title": "EvaluaPro Installer Hub response envelope v1",
  "type": "object",
  "required": ["schemaVersion", "operationId", "ok", "phase", "exitCode", "message"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "operationId": { "type": "string", "format": "uuid" },
    "ok": { "type": "boolean" },
    "phase": { "type": "string", "minLength": 1 },
    "exitCode": { "type": "integer" },
    "message": { "type": "string" },
    "data": { "type": "object" },
    "errorCode": { "type": "string" },
    "online": { "type": "boolean" },
    "skipped": { "type": "boolean" },
    "state": { "type": "string" }
  },
  "additionalProperties": true
}
