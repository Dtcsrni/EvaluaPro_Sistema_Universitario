{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evaluapro.local/contracts/installer-hub/request-envelope-v1.schema.json",
  "title": "EvaluaPro Installer Hub request envelope v1",
  "type": "object",
  "required": ["schemaVersion", "operationId", "command", "issuedAtUtc", "expiresAtUtc", "payload"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "operationId": { "type": "string", "format": "uuid" },
    "command": { "enum": ["detect-prereqs", "post-install", "update", "uninstall"] },
    "issuedAtUtc": { "type": "string", "format": "date-time" },
    "expiresAtUtc": { "type": "string", "format": "date-time" },
    "payload": { "type": "object" },
    "protectedSecrets": { "type": "string", "contentEncoding": "base64" }
  },
  "additionalProperties": false
}
